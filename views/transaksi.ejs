<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Transaksi</title>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <aside
      class="w-64 min-h-screen bg-[#020617] border-r border-gray-800 p-6 flex flex-col justify-between"
    >
      <div>
        <h2 class="text-2xl font-bold mb-8">
          Peak<span class="text-green-400">Finance</span>
        </h2>

        <div class="space-y-2 text-sm">
          <a
            href="/"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:text-green-400 hover:bg-green-500/10"
          >
            🏠 Dashboard
          </a>

          <a
            href="/analitik"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-green-500/10 hover:text-green-400"
          >
            📊 Analitik
          </a>

          <a
            href="/transaksi"
            class="flex items-center gap-3 px-3 py-2 text-gray-400 text-green-400 bg-green-500/20 rounded-lg"
          >
            💸 Transaksi
          </a>

          <a
            href="/target"
            class="flex items-center gap-3 px-3 py-2 text-gray-400 hover:text-green-400 hover:bg-green-500/10 rounded-lg"
          >
            🎯 Target Tabungan
          </a>
        </div>

        <p class="text-xs text-gray-500 mt-8 mb-3">LAINNYA</p>

        <div class="space-y-2 text-sm">
          <div
            class="px-3 py-2 text-gray-400 hover:text-green-400 hover:bg-green-500/10 rounded-lg"
          >
            💡 Insight
          </div>
          <div
            class="px-3 py-2 text-gray-400 hover:text-green-400 hover:bg-green-500/10 rounded-lg"
          >
            📄 Laporan
          </div>
          <div
            class="px-3 py-2 text-gray-400 hover:text-green-400 hover:bg-green-500/10 rounded-lg"
          >
            ⚙️ Pengaturan
          </div>
        </div>
      </div>

      <!-- PROFILE -->
      <div
        class="flex items-center gap-3 p-3 rounded-xl bg-black/40 border border-gray-800"
      >
        <div
          class="w-12 h-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 text-black font-bold"
        >
          R
        </div>
        <div>
          <p class="font-semibold">Rafi Saputra</p>
          <p class="text-xs text-gray-400">Mahasiswa · Bandung</p>
        </div>
      </div>
    </aside>

    <!-- ================= MAIN ================= -->
    <main class="flex-1 px-12 py-10">
      <!-- HEADER -->
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-semibold">Transaksi</h1>

        <div class="flex items-center gap-3">
          <span class="text-gray-400 text-sm">Catat uangmu di sini</span>
          <button
            class="w-10 h-10 bg-green-500 rounded-xl text-black font-bold hover:scale-105 transition"
          >
            +
          </button>
        </div>
      </div>

      <!-- FILTER -->
      <div class="flex gap-3 mb-8">
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          3 hari terakhir
        </button>
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          7 hari terakhir
        </button>
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          30 hari terakhir
        </button>
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          90 hari terakhir
        </button>
      </div>

      <!-- ================= LIST TRANSAKSI ================= -->
      <div class="space-y-4">
        <!-- ITEM 1 -->
        <div
          class="flex justify-between items-center bg-[#020617] border border-gray-800 rounded-2xl px-6 py-5"
        >
          <div>
            <p class="font-semibold text-lg">30 Maret 2026</p>
            <p class="text-sm text-gray-400">
              Kamu telah mencatat masukanmu sebanyak
            </p>
            <p class="text-xs text-gray-500 italic mt-1">
              "Ini tabungan pertamaku. Aku senang mempunyai banyak uang di suatu
              hari nanti."
            </p>
          </div>

          <p class="text-3xl font-bold text-green-400">+ Rp1.500.000</p>
        </div>

        <!-- ITEM 2 -->
        <div
          class="flex justify-between items-center bg-[#020617] border border-gray-800 rounded-2xl px-6 py-5"
        >
          <div>
            <p class="font-semibold text-lg">30 Maret 2026</p>
            <p class="text-sm text-gray-400">
              Kamu telah menabung untuk Sony WH-1000XM5
            </p>
          </div>

          <p class="text-3xl font-bold text-cyan-400">+ Rp1.000.000</p>
        </div>

        <!-- ITEM 3 -->
        <div
          class="flex justify-between items-center bg-[#020617] border border-gray-800 rounded-2xl px-6 py-5"
        >
          <div>
            <p class="font-semibold text-lg">30 Maret 2026</p>
            <p class="text-sm text-gray-400">
              Kamu telah menabung untuk Laptop Baru
            </p>
          </div>

          <p class="text-3xl font-bold text-yellow-400">+ Rp500.000</p>
        </div>
      </div>
    </main>
  </body>
</html>