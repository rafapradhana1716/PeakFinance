<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaksi - PeakFinance</title>
    <link rel="icon" type="image/svg+xml" href="/public/peakfinance-icon-brand%201.svg" />
    <link rel="stylesheet" href="<%= env.BASEURL_VITE %>/public/css/input.css">
    <script type="module" src="<%= env.BASEURL_VITE %>/@vite/client"></script>
    <link rel="stylesheet" href="/css/main.css">
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <%- include('components/sidebar') %>

    <!-- ================= MAIN ================= -->
    <main class="main-content">
      <!-- HEADER -->
      <div class="page-header">
        <div>
          <h1 class="page-title">Transaksi</h1>
          <p class="page-subtitle">Telusuri riwayat pemasukan, pengeluaran, dan tabungan.</p>
        </div>
      </div>

      <!-- FILTER -->
      <div class="filter-row mobile-scroll-row" aria-label="Filter transaksi">
        <button data-days="7" onclick="fetchAndRenderTransactions(7)" class="filter-btn px-3 py-2 bg-gray-800 rounded-lg text-sm">
          7 hari
        </button>
        <button data-days="30" onclick="fetchAndRenderTransactions(30)" class="filter-btn px-3 py-2 bg-gray-800 rounded-lg text-sm">
          30 hari
        </button>
        <button data-days="90" onclick="fetchAndRenderTransactions(90)" class="filter-btn px-3 py-2 bg-gray-800 rounded-lg text-sm">
          90 hari
        </button>
      </div>

      <!-- ================= LIST TRANSAKSI ================= -->
      <div id="transaction-container" class="transaction-list">
        <div id="loading-state" class="empty-state app-panel">
          <p>Sedang memuat riwayat transaksi..</p>
        </div>
      </div>
    </main>
    <script>
      async function fetchAndRenderTransactions(days = 30) {
        const container = document.getElementById('transaction-container');
        
        updateButtonStyles(days);
        try {
          const response = await fetch(`/trx/transactions?days=${days}`);
          const data = await response.json();

          if(data.success && data.transactions.length > 0) {
            container.innerHTML = '';

            data.transactions.forEach(txn => {
              const date = new Date(`${txn.transaction_date}T00:00:00`).toLocaleDateString('id-ID', {
                day: 'numeric', month: 'long', year: 'numeric'
              });
              const amount = Number(txn.amount).toLocaleString('id-ID');
              const typeClass = txn.type === 'income' || txn.type === 'saving' ? 'text-green-400' : 'text-red-400';
              const sign = txn.type === 'income' || txn.type === 'saving' ? '+' : '-';
              const card = document.createElement('a');
              card.href = `/transaksi/${txn.id}`;
              card.className = 'transaction-card transaction-row transition hover:border-green-400 hover:-translate-y-1';
              card.setAttribute('aria-label', `Buka detail transaksi ${txn.name}`);

              const copy = document.createElement('div');
              copy.className = 'transaction-copy';
              const dateText = document.createElement('p');
              dateText.className = 'font-semibold';
              dateText.textContent = date;
              const name = document.createElement('p');
              name.className = 'text-sm text-gray-400 font-medium';
              name.textContent = txn.name;
              const category = document.createElement('span');
              category.className = 'inline-block mt-2 px-2 py-1 text-[10px] uppercase tracking-wider bg-gray-800 text-gray-300 rounded-lg';
              category.textContent = txn.category || 'Umum';
              copy.append(dateText, name, category);

              const transactionAmount = document.createElement('p');
              transactionAmount.className = `transaction-amount ${typeClass}`;
              transactionAmount.textContent = `${sign} Rp${amount}`;
              card.append(copy, transactionAmount);
              container.append(card);
            });
          } else {
            container.innerHTML = '<div class="empty-state app-panel"><p>Tidak ada transaksi dalam ' + days + ' hari terakhir.</p></div>';
          }
        } catch (error) {
          console.error('Error:', error);
          container.innerHTML = '<div class="empty-state app-panel text-red-400"><p>Gagal memuat data. Silakan coba lagi nanti.</p></div>';
        }
      }

      function updateButtonStyles(activeDays) {
        const buttons = document.querySelectorAll('.filter-btn');
        buttons.forEach(btn => {
          const active = Number(btn.dataset.days) === Number(activeDays);
          btn.setAttribute('aria-pressed', String(active));
          if(active) {
            btn.classList.replace('bg-gray-800', 'bg-green-800');
          } else {
            btn.classList.replace('bg-green-800', 'bg-gray-800');
          }
        });
      }
      document.addEventListener('DOMContentLoaded', () => {
        const defaultPeriod = window.PeakPreferences?.get().defaultPeriod || 30;
        fetchAndRenderTransactions(defaultPeriod);
      });
    </script>
  </body>
</html>
