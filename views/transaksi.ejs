<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transaksi - PeakFinance</title>
    <link rel="stylesheet" href="<%= env.BASEURL_VITE %>/public/css/input.css">
    <script type="module" src="<%= env.BASEURL_VITE %>/@vite/client"></script>
    <link rel="stylesheet" href="/css/main.css">
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <%- include('components/sidebar') %>

    <!-- ================= MAIN ================= -->
    <main class="main-content">
      <!-- HEADER -->
      <div class="page-header">
        <div>
          <h1 class="page-title">Transaksi</h1>
          <p class="page-subtitle">Telusuri riwayat pemasukan, pengeluaran, dan tabungan.</p>
        </div>
      </div>

      <!-- FILTER -->
      <div class="filter-row mobile-scroll-row" aria-label="Filter transaksi">
        <button onclick="fetchAndRenderTransactions(7)" class="filter-btn px-3 py-2 bg-gray-800 rounded-lg text-sm">
          7 hari
        </button>
        <button onclick="fetchAndRenderTransactions(30)" class="filter-btn px-3 py-2 bg-gray-800 rounded-lg text-sm">
          30 hari
        </button>
        <button onclick="fetchAndRenderTransactions(90)" class="filter-btn px-3 py-2 bg-gray-800 rounded-lg text-sm">
          90 hari
        </button>
      </div>

      <!-- ================= LIST TRANSAKSI ================= -->
      <div id="transaction-container" class="transaction-list">
        <div id="loading-state" class="empty-state app-panel">
          <p>Sedang memuat riwayat transaksi..</p>
        </div>
      </div>
    </main>
    <script>
      async function fetchAndRenderTransactions(days = 30) {
        const container = document.getElementById('transaction-container');
        
        updateButtonStyles(days);
        try {
          const response = await fetch(`/trx/transactions?days=${days}`);
          const data = await response.json();

          if(data.success && data.transactions.length > 0) {
            container.innerHTML = '';

            data.transactions.forEach(txn => {
              const date = new Date(txn.created_at).toLocaleString('id-ID', {
                day: 'numeric', month: 'long', year: 'numeric'
              });
              const amount = Number(txn.amount).toLocaleString('id-ID');
              const typeClass = txn.type === 'income' || txn.type === 'saving' ? 'text-green-400' : 'text-red-400';
              const sign = txn.type === 'income' || txn.type === 'saving' ? '+' : '-';

              container.innerHTML += `
                <article class="transaction-card transaction-row">
                  <div class="transaction-copy">
                    <p class="font-semibold">${date}</p>
                    <p class="text-sm text-gray-400 font-medium">${txn.name}</p>
                    <span class="inline-block mt-2 px-2 py-1 text-[10px] uppercase tracking-wider bg-gray-800 text-gray-300 rounded-lg">
                      ${txn.category || 'Umum'}
                    </span>
                  </div>
                  <p class="transaction-amount ${typeClass}">${sign} Rp${amount}</p>
                </article>
              `;
            });
          } else {
            container.innerHTML = '<div class="empty-state app-panel"><p>Tidak ada transaksi dalam ' + days + ' hari terakhir.</p></div>';
          }
        } catch (error) {
          console.error('Error:', error);
          container.innerHTML = '<div class="empty-state app-panel text-red-400"><p>Gagal memuat data. Silakan coba lagi nanti.</p></div>';
        }
      }

      function updateButtonStyles(activeDays) {
        const buttons = document.querySelectorAll('.filter-btn');
        buttons.forEach(btn => {
          if(btn.innerText.includes(activeDays)) {
            btn.classList.replace('bg-gray-800', 'bg-green-800');
          } else {
            btn.classList.replace('bg-green-800', 'bg-gray-800');
          }
        });
      }
      document.addEventListener('DOMContentLoaded', () => fetchAndRenderTransactions(30));
    </script>
  </body>
</html>
