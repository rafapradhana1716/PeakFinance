<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Transaksi - PeakFinance</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <%- include('components/sidebar') %>

    <!-- ================= MAIN ================= -->
    <main class="main-content flex-1 px-12 py-10 overflow-y-auto">
      <!-- HEADER -->
      <div  class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4"
      >
        <h1 class="text-3xl font-semibold tracking-wide">Transaksi</h1>
      </div>

      <!-- FILTER -->
      <div class="flex gap-3 mb-8">
        <button onclick="fetchAndRenderTransactions(7)" class="filter-btn px-4 py-2 bg-gray-800 rounded-lg text-sm">
          7 hari terakhir
        </button>
        <button onclick="fetchAndRenderTransactions(30)" class="filter-btn px-4 py-2 bg-gray-800 rounded-lg text-sm">
          30 hari terakhir
        </button>
        <button onclick="fetchAndRenderTransactions(90)" class="filter-btn px-4 py-2 bg-gray-800 rounded-lg text-sm">
          90 hari terakhir
        </button>
      </div>

      <!-- ================= LIST TRANSAKSI ================= -->
      <div id="transaction-container" class="space-y-4">
        <div id="loading-state" class="text-center py-10 text-gray-500">
          <p>Sedang memuat riwayat transaksi..</p>
        </div>
      </div>
    </main>
    <script>
      async function fetchAndRenderTransactions(days = 30) {
        const container = document.getElementById('transaction-container');
        
        updateButtonStyles(days);
        try {
          const response = await fetch(`/trx/transactions-data?days=${days}`);
          const data = await response.json();

          if(data.success && data.transactions.length > 0) {
            container.innerHTML = '';

            data.transactions.forEach(txn => {
              const date = new Date(txn.created_at).toLocaleString('id-ID', {
                day: 'numeric', month: 'long', year: 'numeric'
              });
              const amount = Number(txn.amount).toLocaleString('id-ID');
              const typeClass = txn.type === 'income' ? 'text-green-400' : 'text-red-400';
              const sign = txn.type === 'income' ? '+' : '-';

              container.innerHTML += `
                <div class="flex justify-between items-center bg-[#020617] border border-gray-800 rounded-2xl px-6 py-5">
                  <div>
                    <p class="font-semibold text-lg">${date}</p>
                    <p class="text-sm text-gray-400">Kamu telah mencatat ${txn.type === 'income' ? 'masukanmu' : 'pengeluaranmu'} sebesar</p>
                    <span class="inline-block mt-2 px-2 py-1 text-[10px] uppercase tracking-wider bg-gray-800 text-gray-300 rounded-lg">
                      ${txn.category || 'Umum'}
                    </span>
                  </div>
                  <p class="text-2xl font-bold ${typeClass}">${sign} Rp${amount}</p>
                </div>
              `;
            });
          } else {
            container.innerHTML = '<div class="text-center py-10 text-gray-500"><p>Tidak ada transaksi dalam ' + days + ' hari terakhir.</p></div>';
          }
        } catch (error) {
          console.error('Error:', error);
          container.innerHTML = '<div class="text-center py-10 text-red-400"><p>Gagal memuat data. Silakan coba lagi nanti.</p></div>';
        }
      }

      function updateButtonStyles(activeDays) {
        const buttons = document.querySelectorAll('.filter-btn');
        buttons.forEach(btn => {
          if(btn.innerText.includes(activeDays)) {
            btn.classList.replace('bg-gray-800', 'bg-green-800');
          } else {
            btn.classList.replace('bg-green-800', 'bg-gray-800');
          }
        });
      }
      document.addEventListener('DOMContentLoaded', () => fetchAndRenderTransactions(30));
    </script>
  </body>
</html>