<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Transaksi</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <aside
      class="w-64 min-h-screen bg-[#020617] border-r border-gray-800 p-6 flex flex-col justify-between"
    >
      <div>
        <h2 class="text-2xl font-bold mb-8">
          Peak<span class="text-green-400">Finance</span>
        </h2>

        <div class="space-y-2 text-sm">
          <a
            href="/"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:text-green-400 hover:bg-green-500/10"
          >
            🏠 Dashboard
          </a>

          <a
            href="/analitik"
            class="flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:bg-green-500/10 hover:text-green-400"
          >
            📊 Analitik
          </a>

          <a
            href="/transaksi"
            class="flex items-center gap-3 px-3 py-2 text-gray-400 text-green-400 bg-green-500/20 rounded-lg"
          >
            💸 Transaksi
          </a>

          <a
            href="/target"
            class="flex items-center gap-3 px-3 py-2 text-gray-400 hover:text-green-400 hover:bg-green-500/10 rounded-lg"
          >
            🎯 Target Tabungan
          </a>
        </div>

        <p class="text-xs text-gray-500 mt-8 mb-3">LAINNYA</p>

        <div class="space-y-2 text-sm">
          <a href="/insight"
class="flex gap-3 px-3 py-2 rounded-lg <%= page === 'insight' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
            💡 Insight
          </a>
          <a href="/laporan"
            class="flex gap-3 px-3 py-2 rounded-lg <%= page === 'laporan' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
          
            📄 Laporan
          </a>
          <div
            class="px-3 py-2 text-gray-400 hover:text-green-400 hover:bg-green-500/10 rounded-lg"
          >
            ⚙️ Pengaturan
          </div>
        </div>
      </div>

      <!-- PROFILE -->
      <div
        class="flex items-center gap-3 p-3 rounded-xl bg-black/40 border border-gray-800"
      >
        <div
          class="w-12 h-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 text-black font-bold"
        >
          R
        </div>
        <div>
          <p class="font-semibold"><%= user.firstname %> <%= user.lastname %></p>
          <p class="text-xs text-gray-400"><%= user.username %></p>
        </div>
      </div>
    </aside>

    <!-- ================= MAIN ================= -->
    <main class="flex-1 px-12 py-10">
      <!-- HEADER -->
      <div  class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4"
      >
        <h1 class="text-3xl font-semibold tracking-wide">Transaksi</h1>
      </div>

      <!-- FILTER -->
      <div class="flex gap-3 mb-8">
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          3 hari terakhir
        </button>
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          7 hari terakhir
        </button>
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          30 hari terakhir
        </button>
        <button class="px-4 py-2 bg-gray-800 rounded-lg text-sm">
          90 hari terakhir
        </button>
      </div>

      <!-- ================= LIST TRANSAKSI ================= -->
      <div class="space-y-4">
        <% transactions.forEach(txn => { %>

          <div
            class="flex justify-between items-center bg-[#020617] border border-gray-800 rounded-2xl px-6 py-5"
            >
            <div>
              <p class="font-semibold text-lg"><%= new Date(txn.created_at).toLocaleString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
              <p class="text-sm text-gray-400">
                  Kamu telah mencatat <%= txn.type === 'income' ? 'masukanmu' : 'pengeluaranmu' %> sebesar
              </p>
              <% if (txn.description) { %>
                  <p class="text-xs text-gray-500 italic mt-1 max-w-md">
                      "<%= txn.description %>"
                  </p>
              <% } %>
              <span class="inline-block mt-2 px-2 py-1 text-[10px] uppercase tracking-wider bg-gray-800 text-gray-300 rounded-lg">
                  <%= txn.category || 'Umum' %>
              </span>
            </div>
            
            <p class="text-2xl font-bold <%= txn.type === 'income' ? 'text-green-400' : 'text-red-400' %>">
              <%= txn.type === 'income' ? '+' : '-' %> 
              Rp<%= Number(txn.amount).toLocaleString('id-ID') %>
            </p>
          </div>
        <% }) %>

        <% if (transactions.length === 0) { %>
          <div class="text-center py-10 text-gray-500">
            <p>Belum ada riwayat transaksi nih. Yuk mulai catat!</p>
          </div>
        <% } %>
      </div>
    </main>
  </body>
</html>