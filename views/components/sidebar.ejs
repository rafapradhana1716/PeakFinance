<link rel="stylesheet" href="/css/sidebar.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<script src="/public/js/preferences.js"></script>

<button class="mobile-menu-btn" id="mobileMenuBtn" type="button"
    aria-label="Buka menu navigasi" aria-controls="appSidebar" aria-expanded="false">
    <i class="fa-solid fa-bars" aria-hidden="true"></i>
</button>

<div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

<aside id="appSidebar" class="sidebar no-transition" aria-label="Navigasi utama">
    <div>
        <div class="sidebar-header">
            <a href="/" class="sidebar-brand" aria-label="PeakFinance - Dashboard">
                Peak<span>Finance</span>
            </a>

            <button id="toggleSidebar" type="button" class="sidebar-toggle"
                aria-label="Ciutkan sidebar" aria-expanded="true">
                <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
            </button>
            <button id="mobileCloseBtn" type="button" class="sidebar-close" aria-label="Tutup menu navigasi">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="/" class="nav-item <%= page === 'home' ? 'active' : '' %>">
                <span class="icon"><i class="fa-solid fa-house" aria-hidden="true"></i></span>
                <span class="text" data-i18n="navDashboard">Dashboard</span>
            </a>
            <a href="/analisis" class="nav-item <%= page === 'analisis' ? 'active' : '' %>">
                <span class="icon"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
                <span class="text" data-i18n="navAnalysis">Analisis</span>
            </a>
            <a href="/transaksi" class="nav-item <%= page === 'transaksi' ? 'active' : '' %>">
                <span class="icon"><i class="fa-solid fa-wallet" aria-hidden="true"></i></span>
                <span class="text" data-i18n="navTransactions">Transaksi</span>
            </a>
            <a href="/target" class="nav-item <%= page === 'target' ? 'active' : '' %>">
                <span class="icon"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></span>
                <span class="text" data-i18n="navSavings">Target Tabungan</span>
            </a>
        </nav>

        <p class="sidebar-section-title" data-i18n="navOther">LAINNYA</p>

        <nav class="sidebar-nav" aria-label="Navigasi lainnya">
            <a href="/insight" class="nav-item <%= page === 'insight' ? 'active' : '' %>">
                <span class="icon"><i class="fa-solid fa-lightbulb" aria-hidden="true"></i></span>
                <span class="text" data-i18n="navInsights">Insight</span>
            </a>
            <a href="/pengaturan" class="nav-item <%= page === 'pengaturan' ? 'active' : '' %>">
                <span class="icon"><i class="fa-solid fa-gear" aria-hidden="true"></i></span>
                <span class="text" data-i18n="navSettings">Pengaturan</span>
            </a>
        </nav>
    </div>

    <div class="profile-container">
        <div class="avatar" aria-hidden="true"><i class="fa-solid fa-user"></i></div>
        <div class="profile-text">
            <p id="profile-name">Memuat...</p>
            <p id="profile-username">Memuat...</p>
        </div>
    </div>
</aside>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const links = document.querySelectorAll('.nav-item');
        const currentPath = window.location.pathname;
        const desktopButton = document.getElementById('toggleSidebar');
        const mobileButton = document.getElementById('mobileMenuBtn');
        const mobileCloseButton = document.getElementById('mobileCloseBtn');
        const sidebar = document.getElementById('appSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const mainContent = document.querySelector('.main-content');
        const isMobile = () => window.innerWidth <= 1024;

        links.forEach(link => {
            const isCurrent = link.getAttribute('href') === currentPath;
            link.classList.toggle('active', isCurrent);
            if (isCurrent) link.setAttribute('aria-current', 'page');
        });

        function syncDesktopState() {
            if (!mainContent || isMobile()) return;
            const collapsed = sidebar.classList.contains('collapsed');
            localStorage.setItem('sidebar', collapsed ? 'collapsed' : 'open');
            desktopButton?.setAttribute('aria-expanded', String(!collapsed));
            desktopButton?.setAttribute('aria-label', collapsed ? 'Perluas sidebar' : 'Ciutkan sidebar');
            desktopButton?.querySelector('i')?.classList.toggle('fa-angles-left', !collapsed);
            desktopButton?.querySelector('i')?.classList.toggle('fa-angles-right', collapsed);
        }

        function openMobileSidebar() {
            sidebar.classList.add('mobile-open');
            overlay.classList.add('active');
            overlay.setAttribute('aria-hidden', 'false');
            mobileButton?.classList.add('is-hidden');
            mobileButton?.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
            mobileCloseButton?.focus();
        }

        function closeMobileSidebar({ restoreFocus = false } = {}) {
            sidebar.classList.remove('mobile-open');
            overlay.classList.remove('active');
            overlay.setAttribute('aria-hidden', 'true');
            mobileButton?.classList.remove('is-hidden');
            mobileButton?.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            if (restoreFocus) mobileButton?.focus();
        }

        if (localStorage.getItem('sidebar') === 'collapsed' && !isMobile()) {
            sidebar.classList.add('collapsed');
        }
        syncDesktopState();
        requestAnimationFrame(() => sidebar.classList.remove('no-transition'));

        desktopButton?.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
            syncDesktopState();
            window.PeakPreferences?.set({
                sidebarCollapsed: sidebar.classList.contains('collapsed')
            });
        });
        mobileButton?.addEventListener('click', openMobileSidebar);
        mobileCloseButton?.addEventListener('click', () => closeMobileSidebar({ restoreFocus: true }));
        overlay?.addEventListener('click', () => closeMobileSidebar({ restoreFocus: true }));

        links.forEach(link => link.addEventListener('click', () => {
            if (isMobile()) closeMobileSidebar();
        }));

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && sidebar.classList.contains('mobile-open')) {
                closeMobileSidebar({ restoreFocus: true });
            }
        });

        window.addEventListener('resize', () => {
            if (!isMobile()) {
                closeMobileSidebar();
                sidebar.classList.toggle('collapsed', localStorage.getItem('sidebar') === 'collapsed');
                syncDesktopState();
            }
        });
    });

    async function fetchAndRenderProfile() {
        try {
            const response = await fetch('/auth/profile');
            if (!response.ok) throw new Error('Failed to fetch profile');
            const data = await response.json();
            document.getElementById('profile-name').textContent = `${data.user.firstname} ${data.user.lastname}`;
            document.getElementById('profile-username').textContent = data.user.username;
        } catch (error) {
            console.error('Error fetching profile:', error);
            document.getElementById('profile-name').textContent = 'Guest User';
            document.getElementById('profile-username').textContent = 'user';
        }
    }

    fetchAndRenderProfile();
</script>
