<link rel="stylesheet" href="/css/sidebar.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<aside
    class="sidebar w-64 shrink-0 min-h-screen bg-[#020617] border-r border-gray-800 p-6 flex flex-col justify-between sticky top-0">
    <div>
        <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-bold tracking-wide">
                Peak<span class="text-green-400">Finance</span>
            </h2>

            <button id="toggleSidebar" class="text-gray-400 hover:text-white transition text-lg">
                ☰
            </button>
        </div>

        <div class="space-y-2 text-sm">
            <a href="/"
                class="nav-item flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'home' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/20' %>">
                <span class="icon"><i class="fa-solid fa-house"></i></span>
                <span class="text">Dashboard</span>
            </a>

            <a href="/analisis"
                class="nav-item flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'analisis' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                <span class="icon"><i class="fa-solid fa-chart-line"></i></span>
                <span class="text">Analisis</span>
            </a>

            <a href="/transaksi"
                class="nav-item flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'transaksi' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                <span class="icon"><i class="fa-solid fa-wallet"></i></span>
                <span class="text">Transaksi</span>
            </a>

            <a href="/target"
                class="nav-item flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'target' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                <span class="icon"><i class="fa-solid fa-bullseye"></i></span>
                <span class="text">Target Tabungan</span>

            </a>
        </div>

        <p class="text-xs text-gray-500 mt-8 mb-3">LAINNYA</p>

        <div class="space-y-2 text-sm">
            <a href="/insight"
                class="nav-item flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'insight' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                <span class="icon"><i class="fa-solid fa-lightbulb"></i></span>
                <span class="text">Insight</span>
            </a>
            <a href="/laporan"
                class="nav-item flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'laporan' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                <span class="icon"><i class="fa-solid fa-file-lines"></i></span>
                <span class="text">Laporan</span>
            </a>
            <a href="/pengaturan"
                class="nav-item flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'pengaturan' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                <span class="icon"><i class="fa-solid fa-gear"></i></span>
                <span class="text">Pengaturan</span>
            </a>
        </div>
    </div>

    <!-- PROFILE -->
    <div class="profile-container flex items-center gap-3 p-3 rounded-xl bg-black/40 border border-gray-800">
    <div class="avatar w-12 h-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 text-black font-bold">
        <i class="fa-solid fa-user"></i>
    </div>
    <div class="profile-text">
        <p class="font-semibold">
            <%= user.firstname %> <%= user.lastname %>
        </p>
        <p class="text-xs text-gray-400">
            <%= user.username %>
        </p>
    </div>
</div>
</aside>

<script>
    const links = document.querySelectorAll('.nav-item');
    const currentPath = window.location.pathname;

    links.forEach(link => {
        if (link.getAttribute('href') === currentPath) {
            link.classList.add('active');
        }
    });

    const btn = document.getElementById("toggleSidebar");
    const sidebar = document.querySelector(".sidebar");

    btn.addEventListener("click", () => {
        sidebar.classList.toggle("collapsed");
    });
</script>