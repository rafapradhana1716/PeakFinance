<aside
    class="w-64 shrink-0 min-h-screen bg-[#020617] border-r border-gray-800 p-6 flex flex-col justify-between sticky top-0">
    <div>
        <h2 class="text-2xl font-bold mb-8 tracking-wide">
            Peak<span class="text-green-400">Finance</span>
        </h2>

        <div class="space-y-2 text-sm">
            <a href="/"
                class="flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'home' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/20' %>">
                <div class="flex items-center">
                    <span>🏠 Dashboard</span>
                </div>
            </a>

            <a href="/analisis"
                class="flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'analisis' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                📊 Analisis
            </a>

            <a href="/transaksi"
                class="flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'transaksi' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                💸 Transaksi
            </a>

            <a href="/target"
                class="flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'target' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                🎯 Target Tabungan
            </a>
        </div>

        <p class="text-xs text-gray-500 mt-8 mb-3">LAINNYA</p>

        <div class="space-y-2 text-sm">
            <a href="/insight"
                class="flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'insight' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                💡 Insight
            </a>
            <a href="/laporan"
                class="flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'laporan' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                📄 Laporan
            </a>
            <a href="/pengaturan"
                class="flex items-center gap-3 px-3 py-2 rounded-lg <%= page === 'pengaturan' ? 'bg-green-500/20 text-green-400' : 'text-gray-400 hover:text-green-400 hover:bg-green-500/10' %>">
                ⚙️ Pengaturan
            </a>
        </div>
    </div>

    <!-- PROFILE -->
    <div class="flex items-center gap-3 p-3 rounded-xl bg-black/40 border border-gray-800">
        <div
            class="w-12 h-12 flex items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 text-black font-bold">
            X
        </div>
        <div>
            <p class="font-semibold">
                <%= user.firstname %>
                    <%= user.lastname %>
            </p>
            <p class="text-xs text-gray-400">
                <%= user.username %>
            </p>
        </div>
    </div>
</aside>