<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - PeakFinance</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      #dropdownMenu::-webkit-scrollbar {
        width: 8px;
      }
      #dropdownMenu::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.8);
        border-radius: 4px;
      }
      #dropdownMenu::-webkit-scrollbar-thumb {
        background: #22c55e;
        border-radius: 4px;
        border: 2px solid rgba(15, 23, 42, 0.8);
      }
      #dropdownMenu::-webkit-scrollbar-thumb:hover {
        background: #16a34a;
      }
      #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .toast {
        background: #0f172a;
        border: 1px solid #22c55e;
        border-radius: 12px;
        padding: 12px 20px;
        color: white;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        animation: toastIn 0.3s ease-out;
      }

      @keyframes toastIn {
        from {
          transform: translateX(100%);
          opacity: 0;
        }
        to {
          transform: translateX(0);
          opacity: 1;
        }
      }
    </style>
  </head>

  <body
    class="min-h-screen flex bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617] text-white"
  >
    <!-- ================= SIDEBAR ================= -->
    <%- include('components/sidebar') %>

    <!-- Main-Content -->
    <main
      id="mainContent"
      class="main-content flex-1 px-12 py-10 overflow-y-auto"
    >
      <!-- HEADER -->
      <div
        class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4"
      >
        <h1 class="text-3xl font-semibold tracking-wide">Dashboard</h1>

        <div
          class="flex items-center gap-3 bg-[#020617] border border-gray-800 px-4 py-2 rounded-xl"
        >
          <span class="text-sm text-gray-400">Catat uangmu di sini</span>
          <button
            onclick="openModal()"
            class="w-10 h-10 bg-green-500 rounded-xl text-black text-lg font-bold hover:scale-105 transition"
          >
            +
          </button>
        </div>
      </div>

      <!-- HERO -->
      <div class="flex justify-between items-start mb-10">
        <h2 class="text-4xl font-bold leading-tight" id="greeting">
          Memuat..
        </h2>

        <div class="text-right">
          <p class="text-xs text-gray-400">Awas pinjol ilegal!</p>
          <p class="text-green-400 font-semibold text-sm">Siap nabung lagi?</p>
          <p class="text-xs text-gray-500">Bagi THR dong...</p>
        </div>
      </div>

      <!-- Card bagian atas -->
      <div class="grid grid-cols-3 gap-6 mb-12">
        <!-- TABUNGAN -->
        <div
          class="col-span-2 bg-gradient-to-r from-[#020617] to-[#0f172a] border border-gray-800 rounded-2xl p-6 shadow-lg"
        >
          <p class="text-xs text-gray-400 mb-2 tracking-wide">
            TABUNGAN BULAN INI
          </p>
          <h2 id="balance" class="text-3xl text-green-400 font-bold mb-2">
            Memuat..
          </h2>
          <p class="text-xs text-gray-400 mb-6">Maret 2026, 9 hari lagi</p>

          <div class="grid grid-cols-3 gap-4">
            <div
              class="bg-[#020617] border border-gray-800 rounded-xl p-4 text-center"
            >
              <p class="text-xs text-gray-400">TARGET</p>
              <p class="text-yellow-400 font-semibold">+Rp1.5jt</p>
            </div>

            <div
              class="bg-[#020617] border border-gray-800 rounded-xl p-4 text-center"
            >
              <p class="text-xs text-gray-400">PENGELUARAN</p>
              <p id="totalPengeluaran">Memuat..</p>
            </div>

            <div
              class="bg-[#020617] border border-gray-800 rounded-xl p-4 text-center"
            >
              <p class="text-xs text-gray-400">TABUNGAN</p>
              <p id="totalPemasukan" class="text-green-400">Memuat..</p>
            </div>
          </div>
        </div>

        <!-- SCORE -->
        <div
          id="scoreCard"
          class="bg-gradient-to-br from-gray-500/20 to-transparent border border-gray-500/30 rounded-2xl p-5 h-[220px] flex flex-col shadow-lg"
        >
          <!-- HEADER -->
          <div class="flex justify-between items-center mb-2">
            <p class="text-xs text-gray-400 tracking-wide">SKOR KEUANGAN</p>
            <span
              id="ratingKeuangan"
              class="text-xs bg-gray-500/20 text-gray-400 px-2 py-1 rounded-lg border border-gray-500/30"
            >
              Memuat...
            </span>
          </div>

          <!-- CONTENT -->
          <div class="flex flex-col items-center justify-center flex-1">
            <div
              class="relative w-24 h-24 flex items-center justify-center mb-3"
            >
              <canvas id="scoreChart"></canvas>
            </div>

            <p id="labelKeuangan" class="font-semibold text-sm">Memuat...</p>
            <p id="titleKeuangan" class="text-xs text-gray-400">Memuat...</p>
          </div>
        </div>
      </div>

      <div class="mb-4">
        <h2 class="text-xl font-semibold">What's New?</h2>
        <p class="text-sm text-gray-400">Insight Terbaru</p>
        <p class="text-xs text-gray-500">Dalam satu bulan terakhir</p>
      </div>

      <div class="grid grid-cols-4 gap-6">
        <div
          class="relative bg-[#020617] border border-gray-800 rounded-2xl p-5 hover:border-green-400 hover:-translate-y-1 transition"
        >
          <div
            class="absolute -top-3 right-6 w-4 h-4 bg-green-400 rounded-full"
          ></div>
          <h3 class="font-semibold mb-2">Tips Menghindari Pajak (Legal)</h3>
          <p class="text-xs text-gray-400">Ditulis oleh Rahmantyo</p>
          <p class="text-xs text-gray-400 mb-2">Dibaca 10.045 kali</p>
          <p class="text-sm text-gray-300">Preview artikel...</p>
        </div>

        <div
          class="relative bg-[#020617] border border-gray-800 rounded-2xl p-5 hover:border-green-400 hover:-translate-y-1 transition"
        >
          <div
            class="absolute -top-3 right-6 w-4 h-4 bg-green-400 rounded-full"
          ></div>
          <h3 class="font-semibold mb-2">Indonesia Miskin?</h3>
          <p class="text-xs text-gray-400">Ditulis oleh Kok Bisa?</p>
          <p class="text-xs text-gray-400 mb-2">Dibaca 7.592 kali</p>
          <p class="text-sm text-gray-300">Preview artikel...</p>
        </div>

        <div
          class="relative bg-[#020617] border border-gray-800 rounded-2xl p-5 hover:border-green-400 hover:-translate-y-1 transition"
        >
          <div
            class="absolute -top-3 right-6 w-4 h-4 bg-green-400 rounded-full"
          ></div>
          <h3 class="font-semibold mb-2">Strategi ke Jerman</h3>
          <p class="text-xs text-gray-400">Ditulis oleh Schmitz</p>
          <p class="text-xs text-gray-400 mb-2">Dibaca 9.010 kali</p>
          <p class="text-sm text-gray-300">Preview artikel...</p>
        </div>

        <div
          class="relative bg-[#020617] border border-gray-800 rounded-2xl p-5 hover:border-green-400 hover:-translate-y-1 transition"
        >
          <div
            class="absolute -top-3 right-6 w-4 h-4 bg-green-400 rounded-full"
          ></div>
          <h3 class="font-semibold mb-2">Biografi Elon Musk</h3>
          <p class="text-xs text-gray-400">Ditulis oleh Benjamin</p>
          <p class="text-xs text-gray-400 mb-2">Dibaca 6.258 kali</p>
          <p class="text-sm text-gray-300">Preview artikel...</p>
        </div>
      </div>
    </main>

    <!-- Modal-Content -->
    <div
      id="modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 px-4 py-6"
    >
      <div
        class="w-full max-w-lg overflow-hidden rounded-3xl border border-green-400/10 bg-[#020617]"
      >
        <div class="px-6 py-6">
          <div class="mb-5" id="modalHeader">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-green-300/70">
                  Catat Keuangan
                </p>
                <h2 class="text-2xl font-semibold text-white">
                  Tambah Transaksi
                </h2>
              </div>
              <button
                type="button"
                id="navTabungan"
                onclick="showPage(2)"
                class="rounded-2xl border border-green-400 px-4 py-3 text-sm font-semibold text-green-300 transition hover:bg-green-400/10"
              >
                Tabungan <span class="text-lg">›</span>
              </button>
            </div>
          </div>

          <form
            action="/trx/add"
            method="POST"
            id="transactionForm"
            class="space-y-4"
          >
            <div id="page1" class="space-y-4">
              <input
                type="text"
                placeholder="Nama transaksi"
                name="name"
                required
                class="w-full rounded-2xl border border-gray-800 bg-[#020617] px-4 py-4 text-white outline-none transition focus:border-green-400"
              />

              <input
                type="text"
                id="amountDisplay"
                placeholder="Jumlah uang"
                oninput="formatRupiah(this)"
                required
                class="w-full rounded-2xl border border-gray-800 bg-[#020617] px-4 py-4 text-white outline-none transition focus:border-green-400"
              />
              <input type="hidden" name="amount" id="amountActual" />
              <input type="hidden" name="type" id="typeInput" value="income" />
              <input
                type="hidden"
                id="selectedKategori"
                name="category"
                value=""
              />

              <div class="grid gap-3 sm:grid-cols-2">
                <button
                  type="button"
                  id="pemasukanBtn"
                  onclick="setType('income')"
                  class="w-full rounded-2xl bg-green-400 px-4 py-3 text-sm font-semibold text-black transition hover:bg-green-300"
                >
                  Pemasukan
                </button>
                <button
                  type="button"
                  id="pengeluaranBtn"
                  onclick="setType('expense')"
                  class="w-full rounded-2xl border border-green-400 px-4 py-3 text-sm font-semibold text-green-300 transition hover:bg-green-400/10"
                >
                  Pengeluaran
                </button>
              </div>

              <div id="kategoriSection" class="hidden space-y-3">
                <p class="text-xs uppercase tracking-[0.2em] text-gray-500">
                  Kategori
                </p>
                <div class="grid grid-cols-3 gap-2">
                  <button
                    type="button"
                    onclick="setKategori(this, 'Makanan')"
                    class="kategori-btn rounded-2xl border border-gray-700 bg-slate-950/90 px-2 py-3 text-xs font-semibold text-gray-400 transition hover:border-green-400 hover:text-green-400"
                  >
                    🍔 Makanan
                  </button>
                  <button
                    type="button"
                    onclick="setKategori(this, 'Transport')"
                    class="kategori-btn rounded-2xl border border-gray-700 bg-slate-950/90 px-2 py-3 text-xs font-semibold text-gray-400 transition hover:border-green-400 hover:text-green-400"
                  >
                    🚌 Transport
                  </button>
                  <button
                    type="button"
                    onclick="setKategori(this, 'Hiburan')"
                    class="kategori-btn rounded-2xl border border-gray-700 bg-slate-950/90 px-2 py-3 text-xs font-semibold text-gray-400 transition hover:border-green-400 hover:text-green-400"
                  >
                    🎮 Hiburan
                  </button>
                  <button
                    type="button"
                    onclick="setKategori(this, 'Belanja')"
                    class="kategori-btn rounded-2xl border border-gray-700 bg-slate-950/90 px-2 py-3 text-xs font-semibold text-gray-400 transition hover:border-green-400 hover:text-green-400"
                  >
                    🛍️ Belanja
                  </button>
                  <button
                    type="button"
                    onclick="setKategori(this, 'Pendidikan')"
                    class="kategori-btn rounded-2xl border border-gray-700 bg-slate-950/90 px-2 py-3 text-xs font-semibold text-gray-400 transition hover:border-green-400 hover:text-green-400"
                  >
                    📚 Pendidikan
                  </button>
                  <button
                    type="button"
                    onclick="setKategori(this, 'Kesehatan')"
                    class="kategori-btn rounded-2xl border border-gray-700 bg-slate-950/90 px-2 py-3 text-xs font-semibold text-gray-400 transition hover:border-green-400 hover:text-green-400"
                  >
                    💊 Kesehatan
                  </button>
                  <button
                    type="button"
                    onclick="setKategori(this, 'Lainnya')"
                    class="kategori-btn rounded-2xl border border-gray-700 bg-slate-950/90 px-2 py-3 text-xs font-semibold text-gray-400 transition hover:border-green-400 hover:text-green-400"
                  >
                    ➕ Lainnya
                  </button>
                </div>

                <div id="lainnyaInput" class="hidden">
                  <input
                    type="text"
                    id="kategoriLainnya"
                    placeholder="Tulis kategori..."
                    class="w-full rounded-2xl border border-gray-700 bg-[#0f172a] px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-green-400"
                    oninput="setKategoriLainnya(this.value)"
                  />
                </div>
              </div>

              <textarea
                name="description"
                placeholder="Catatan..."
                class="w-full min-h-[120px] rounded-3xl border border-gray-800 bg-[#020617] px-4 py-4 text-white outline-none transition focus:border-green-400"
              ></textarea>

              <div class="flex flex-col gap-3 sm:flex-row sm:justify-between">
                <button
                  type="button"
                  onclick="closeModal()"
                  class="w-full rounded-2xl border border-red-400 bg-red-400/10 px-5 py-3 text-sm font-semibold text-red-300 transition hover:bg-red-400/20 sm:w-auto"
                >
                  Batal
                </button>
                <button
                  type="submit"
                  class="w-full rounded-2xl bg-green-400 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-green-300 sm:w-auto"
                >
                  Simpan
                </button>
              </div>
            </div>
          </form>

          <div id="page2" class="hidden space-y-5">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-green-300/70">
                  Tabungan
                </p>
                <h2 class="text-2xl font-semibold text-white">
                  Pilih Target Tabungan
                </h2>
              </div>
              <button
                type="button"
                onclick="
                  event.preventDefault();
                  showPage(1);
                "
                class="rounded-2xl border border-green-400 px-4 py-3 text-sm font-semibold text-green-300 transition hover:bg-green-400/10"
              >
                Kembali <span class="text-lg">‹</span>
              </button>
            </div>

            <div
              class="rounded-2xl border border-green-400/30 bg-green-400/5 p-4 text-center"
            >
              <p class="text-xs text-gray-400 mb-2">Saldo Tabungan Saat Ini</p>
              <h1 id="balance" class="text-3xl font-bold text-gray-400">
                Memuat..
              </h1>
            </div>

            <div class="space-y-3 border-t border-gray-800 pt-4">
              <div>
                <p
                  class="text-xs uppercase tracking-[0.2em] text-gray-500 mb-3"
                >
                  Pilih Target Tabungan
                </p>
                <div class="relative w-full" id="dropdown-container">
                  <button
                    type="button"
                    id="dropdownToggle"
                    class="w-full flex items-center justify-between border border-green-400/40 bg-slate-950/50 text-green-300 px-4 py-3 rounded-xl text-sm transition hover:border-green-400"
                    onclick="toggleDropdown()"
                  >
                    <span id="selectedText">Pilih target tabungan...</span>
                    <svg
                      class="w-4 h-4 transition-transform"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 14l-7 7m0 0l-7-7m7 7V3"
                      ></path>
                    </svg>
                  </button>
                  <div
                    id="dropdownMenu"
                    class="absolute top-full left-0 right-0 bg-slate-900 border border-green-400/40 rounded-xl mt-2 z-50 invisible opacity-0 transition-all duration-200 max-h-64 overflow-y-auto"
                  >
                    <div class="px-4 py-3 text-gray-500 text-xs italic">
                      Memuat data...
                    </div>
                    <div
                      class="dropdown-item px-4 py-2.5 text-green-300 text-sm cursor-pointer border-b border-green-400/10 last:border-b-0 hover:bg-green-400/10 transition"
                      onclick="selectTabunganDropdown('Sony WH-1000XM5')"
                    >
                      Sony WH-1000XM5
                    </div>
                    <div
                      class="dropdown-item px-4 py-2.5 text-green-300 text-sm cursor-pointer border-b border-green-400/10 last:border-b-0 hover:bg-green-400/10 transition"
                      onclick="selectTabunganDropdown('Laptop Baru')"
                    >
                      Laptop Baru
                    </div>
                  </div>
                </div>
                <input type="hidden" id="targetTabunganValue" value="" />
              </div>

              <div class="pt-2">
                <button
                  type="button"
                  onclick="
                    document
                      .getElementById('newTabunganForm')
                      .classList.toggle('hidden')
                  "
                  class="text-xs text-green-400 hover:text-green-300 transition font-semibold"
                >
                  + Tambah Target Baru
                </button>
                <div
                  id="newTabunganForm"
                  class="hidden space-y-2 mt-3 pt-3 border-t border-gray-800"
                >
                  <input
                    type="text"
                    id="namaTabunganInput"
                    placeholder="Nama tujuan tabungan..."
                    class="w-full rounded-xl border border-gray-700 bg-[#0f172a] px-3 py-2 text-sm text-white placeholder-gray-600 outline-none transition focus:border-green-400"
                  />
                  <input
                    type="text"
                    id="targetAmountInput"
                    placeholder="Jumlah target tabungan..."
                    oninput="formatRupiah(this)"
                    class="w-full rounded-xl border border-gray-700 bg-[#0f172a] px-3 py-2 text-sm text-white placeholder-gray-600 outline-none transition focus:border-green-400"
                  />
                  <button
                    type="button"
                    onclick="addTabunganFromInput()"
                    class="w-full rounded-xl border border-green-400/50 bg-green-400/10 px-3 py-2 text-xs font-semibold text-green-300 transition hover:bg-green-400/20 hover:border-green-400"
                  >
                    Tambah
                  </button>
                </div>
              </div>
            </div>

            <div class="space-y-3 border-t border-gray-800 pt-4">
              <label class="text-xs uppercase tracking-[0.2em] text-gray-500"
                >Jumlah Untuk Tabungan Ini</label
              >
              <input
                type="text"
                id="jumlahTabunganInput"
                placeholder="Masukkan jumlah..."
                oninput="formatRupiah(this)"
                class="w-full rounded-xl border border-gray-700 bg-[#0f172a] px-4 py-3 text-white placeholder-gray-600 outline-none transition focus:border-green-400"
              />
            </div>

            <div class="flex gap-3 pt-2">
              <button
                type="button"
                onclick="closeModal()"
                class="flex-1 rounded-xl border border-red-400/50 bg-red-400/10 px-4 py-3 text-sm font-semibold text-red-300 transition hover:bg-red-400/20 hover:border-red-400"
              >
                Batal
              </button>
              <button
                type="button"
                onclick="savingsUpdate()"
                class="flex-1 rounded-xl bg-green-400 px-4 py-3 text-sm font-semibold text-slate-950 transition hover:bg-green-300"
              >
                Simpan Tabungan
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="toast-container"></div>
    <script>
      function getGreeting() {
        const hour = new Date().getHours();
        if (hour >= 5 && hour < 12) return "Selamat Pagi!";
        if (hour >= 12 && hour < 15) return "Selamat Siang! ";
        if (hour >= 15 && hour < 19) return "Selamat Sore! ";
        return "Selamat Malam! ";
      }

      async function initializeGreeting() {
        const greeting = getGreeting();
        const response = await fetch("/auth/profile");
        const data = await response.json();
        document.getElementById("greeting").textContent = greeting + data.user.username;
      }

      initializeGreeting();

      function formatRupiah(el) {
        let rawValue = el.value.replace(/[^0-9]/g, "");
        const hiddenInput = document.getElementById("amountActual");
        if (hiddenInput) {
          hiddenInput.value = rawValue;
        }

        if (!rawValue) {
          el.value = "";
          return;
        }

        let formatted = new Intl.NumberFormat("id-ID").format(rawValue);
        el.value = formatted;
      }

      function openModal() {
        const m = document.getElementById("modal");
        m.classList.remove("hidden");
        m.classList.add("flex");
        showPage(1);
      }

      function closeModal() {
        const m = document.getElementById("modal");
        m.classList.add("hidden");
        m.classList.remove("flex");
      }

      function showPage(page) {
        document.getElementById("page1").classList.toggle("hidden", page !== 1);
        document.getElementById("page2").classList.toggle("hidden", page !== 2);
        document
          .getElementById("navTabungan")
          .classList.toggle("hidden", page !== 1);
        document
          .getElementById("modalHeader")
          .classList.toggle("hidden", page !== 1);

        if (page === 2) {
          fetchAndRenderSavings();
        }
      }

      function nextPage() {
        showPage(2);
      }

      function prevPage() {
        showPage(1);
      }

      /* TOGGLE */
      function setType(type) {
        const typeInput = document.getElementById("typeInput");
        const kategoriSection = document.getElementById("kategoriSection");
        const pemasukanBtn = document.getElementById("pemasukanBtn");
        const pengeluaranBtn = document.getElementById("pengeluaranBtn");

        typeInput.value = type;

        if (type === "expense") {
          pengeluaranBtn.className =
            "w-full rounded-2xl bg-green-400 px-4 py-3 text-sm font-semibold text-black transition hover:bg-green-300";
          pemasukanBtn.className =
            "w-full rounded-2xl border border-green-400 px-4 py-3 text-sm font-semibold text-green-300 transition hover:bg-green-400/10";
          kategoriSection.classList.remove("hidden");
        } else {
          pemasukanBtn.className =
            "w-full rounded-2xl bg-green-400 px-4 py-3 text-sm font-semibold text-black transition hover:bg-green-300";
          pengeluaranBtn.className =
            "w-full rounded-2xl border border-green-400 px-4 py-3 text-sm font-semibold text-green-300 transition hover:bg-green-400/10";

          kategoriSection.classList.add("hidden");
          document.getElementById("selectedKategori").value = "";
          document.querySelectorAll(".kategori-btn").forEach((b) => {
            b.classList.remove(
              "border-green-400",
              "text-green-400",
              "bg-green-400/10",
            );
            b.classList.add("border-gray-700", "text-gray-400");
          });
        }
      }

      function showToast(message, type = "success", duration = 5000) {
        const container = document.getElementById("toast-container");

        const toast = document.createElement("div");
        toast.className = `toast toast-${type}`;

        toast.innerHTML = `
    <span style="font-size:20px">
      ${type === "success" ? "✅" : "❌"}
    </span>

    <div style="flex:1">
      <div style="font-weight:600; margin-bottom:2px">
        ${type === "success" ? "Berhasil" : "Gagal"}
      </div>
      <div style="font-size:13px; color:var(--soft)">
        ${message}
      </div>
    </div>

    <button class="toast-close">✖</button>

    <div class="toast-progress"></div>
  `;

        const progress = toast.querySelector(".toast-progress");
        progress.style.animationDuration = duration + "ms";

        const closeBtn = toast.querySelector(".toast-close");

        closeBtn.onclick = () => removeToast(toast);

        container.appendChild(toast);

        const timeout = setTimeout(() => {
          removeToast(toast);
        }, duration);

        function removeToast(el) {
          el.style.animation = "toastOut 0.3s ease forwards";
          clearTimeout(timeout);
          setTimeout(() => el.remove(), 300);
        }
      }

      //chart doughnut
      let scoreChart;
      document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById("scoreChart").getContext("2d");
        scoreChart = new Chart(ctx, {
          type: "doughnut",
          data: {
            labels: ["Skor Keuangan", "Sisa Target"],
            datasets: [
              {
                data: [0, 0],
                backgroundColor: ["#4ade80", "#1e293b"],
                borderColor: ["#22c55e", "#334155"],
                borderWidth: 1,
                circumference: 360,
                rotation: 0,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            cutout: "70%",
            plugins: {
              legend: {
                display: false,
              },
              tooltip: {
                enabled: false,
              },
            },
          },
          plugins: [
            {
              id: "textCenter",
              beforeDatasetsDraw(chart) {
                const { width, height, ctx } = chart;
                ctx.restore();

                const score = chart.data.datasets[0].data[0];
                const fontSize = (height / 80).toFixed(2);
                ctx.font = `bold ${fontSize}em sans-serif`;
                ctx.textBaseline = "middle";

                ctx.fillStyle = chart.data.datasets[0].backgroundColor[0];

                const text = score + "%";
                const textX = Math.round(
                  (width - ctx.measureText(text).width) / 2,
                );
                const textY = height / 2;

                ctx.fillText(text, textX, textY);
                ctx.save();
              },
            },
          ],
        });
      });

      function updateChartScore(percentage) {
        if (scoreChart) {
          const remaining = 100 - percentage;

          let color = "#4ade80";
          let borderColor = "#22c55e";
          let rating = "HEMAT";
          let className =
            "text-xs bg-green-500/20 text-green-400 px-2 py-1 rounded-lg border border-green-500/30";
          let label = "Sehat Banget 🔥";
          let title = "Saver Master";
          let bgClass =
            "bg-gradient-to-br from-green-500/20 to-transparent border border-green-500/30 rounded-2xl p-5 h-[220px] flex flex-col shadow-lg";

          if (percentage <= 40) {
            color = "#ef4444";
            borderColor = "#dc2626";
            rating = "BOROS";
            className =
              "text-xs bg-red-500/20 text-red-400 px-2 py-1 rounded-lg border border-red-500/30";
            label = "Jaga Uangmu❗";
            title = "Saver Beginner";
            bgClass =
              "bg-gradient-to-br from-red-500/20 to-transparent border border-red-500/30 rounded-2xl p-5 h-[220px] flex flex-col shadow-lg";
          } else if (percentage <= 70) {
            color = "#f59e0b";
            borderColor = "#d97706";
            rating = "HAMPIR";
            className =
              "text-xs bg-yellow-500/20 text-yellow-400 px-2 py-1 rounded-lg border border-yellow-500/30";
            label = "Ingat Tujuanmu ⚠️";
            title = "Saver Intermediate";
            bgClass =
              "bg-gradient-to-br from-yellow-500/20 to-transparent border border-yellow-500/30 rounded-2xl p-5 h-[220px] flex flex-col shadow-lg";
          }

          scoreChart.data.datasets[0].data = [percentage, remaining];
          scoreChart.data.datasets[0].backgroundColor[0] = color;
          scoreChart.data.datasets[0].borderColor[0] = borderColor;
          document.getElementById("ratingKeuangan").textContent = `${rating}`;
          document.getElementById("ratingKeuangan").className = className;
          document.getElementById("labelKeuangan").textContent = `${label}`;
          document.getElementById("titleKeuangan").textContent = `${title}`;
          document.getElementById("scoreCard").className = bgClass;

          scoreChart.update();
        }
      }

      document
        .getElementById("transactionForm")
        .addEventListener("submit", function (e) {
          e.preventDefault();
          showToast("Transaksi berhasil ditambahkan!", "success");
          setTimeout(() => {
            this.submit();
          }, 800);
        });

      function openAddTabunganForm() {
        const namaTabungan = prompt("Masukkan nama tujuan tabungan:");
        if (namaTabungan && namaTabungan.trim()) {
          showToast(
            `Tabungan '${namaTabungan}' berhasil ditambahkan!`,
            "success",
          );
        }
      }

      function addTabunganFromInput() {
        const namaInput = document.getElementById("namaTabunganInput");
        const targetInput = document.getElementById("targetAmountInput");
        const namaTabungan = namaInput.value.trim();
        const targetAmountStr = targetInput.value.replace(/[^0-9]/g, "");
        const targetAmount = parseInt(targetAmountStr);

        if (!namaTabungan) {
          showToast("Nama tabungan tidak boleh kosong", "error");
          return;
        }

        if (!targetAmount || targetAmount <= 0) {
          showToast("Jumlah target tabungan harus lebih dari 0", "error");
          return;
        }

        fetch("/savings/add", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title: namaTabungan, target: targetAmount }),
        })
          .then((response) => {
            if (response.ok) {
              fetchAndRenderSavings();
              showToast(
                `Tabungan '${namaTabungan}' berhasil ditambahkan!`,
                "success",
              );
              namaInput.value = "";
              targetInput.value = "";
              document
                .getElementById("newTabunganForm")
                .classList.add("hidden");
            } else {
              return response.json().then((data) => {
                closeModal();
                showToast(
                  data.message || "Gagal menambahkan tabungan",
                  "error",
                );
              });
            }
          })
          .catch((err) => {
            closeModal();
            showToast("Terjadi kesalahan sistem", "error");
          });
      }

      function toggleDropdown() {
        const menu = document.getElementById("dropdownMenu");
        const isOpen = menu.classList.contains("visible");

        if (isOpen) {
          menu.classList.remove("visible", "opacity-100");
          menu.classList.add("invisible", "opacity-0");
        } else {
          menu.classList.add("visible", "opacity-100");
          menu.classList.remove("invisible", "opacity-0");
        }
      }

      // Tutup dropdown saat klik di luar
      document.addEventListener("click", function (e) {
        const container = document.getElementById("dropdown-container");
        const menu = document.getElementById("dropdownMenu");

        if (
          container &&
          !container.contains(e.target) &&
          menu.classList.contains("visible")
        ) {
          menu.classList.remove("visible", "opacity-100");
          menu.classList.add("invisible", "opacity-0");
        }
      });

      function setKategori(el, nama) {
        document.querySelectorAll(".kategori-btn").forEach((b) => {
          b.classList.remove(
            "border-green-400",
            "text-green-400",
            "bg-green-400/10",
          );
          b.classList.add("border-gray-700", "text-gray-400");
        });

        el.classList.remove("border-gray-700", "text-gray-400");
        el.classList.add(
          "border-green-400",
          "text-green-400",
          "bg-green-400/10",
        );

        // Tampilin sama sembunyikan input yang lain
        const lainnyaInput = document.getElementById("lainnyaInput");
        if (nama === "Lainnya") {
          lainnyaInput.classList.remove("hidden");
          document.getElementById("selectedKategori").value = "";
          document.getElementById("kategoriLainnya").focus();
        } else {
          lainnyaInput.classList.add("hidden");
          document.getElementById("kategoriLainnya").value = "";
          document.getElementById("selectedKategori").value = nama;
        }
      }

      function setKategoriLainnya(value) {
        document.getElementById("selectedKategori").value = value;
      }

      function formatRupiahRingkas(amount) {
        if (amount === 0) return "Rp0";

        const absAmount = Math.abs(amount);
        let formatted = "";

        if (absAmount >= 1000000000) {
          formatted =
            (absAmount / 1000000000).toFixed(1).replace(/\.0$/, "") + "M";
        } else if (absAmount >= 1000000) {
          formatted =
            (absAmount / 1000000).toFixed(1).replace(/\.0$/, "") + "jt";
        } else if (absAmount >= 1000) {
          formatted = (absAmount / 1000).toFixed(1).replace(/\.0$/, "") + "rb";
        } else {
          formatted = absAmount.toString();
        }

        return `Rp${formatted}`;
      }

      async function savingsUpdate() {
        const goalId = document.getElementById("targetTabunganValue").value;
        const amountStr = document
          .getElementById("jumlahTabunganInput")
          .value.replace(/[^0-9]/g, "");
        const amount = parseInt(amountStr);
        const name = document.getElementById("selectedText").textContent;

        if (!goalId) {
          closeModal();
          return showToast("Pilih target tabungan dulu!", "error");
        }
        if (!amount || amount <= 0) {
          closeModal();
          return showToast("Masukkan jumlah uang yang valid!", "error");
        }

        try {
          const response = await fetch("/savings/update-goals", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ goalId, amount, name }),
          });
          const result = await response.json();

          if (result.success) {
            closeModal();
            showToast("Tabungan berhasil ditambahkan!", "success");
            fetchAndRenderBalance();
          } else {
            closeModal();
            showToast("Gagal mengupdate tabungan!", "error");
          }
        } catch (err) {
          closeModal();
          showToast("Terjadi kesalahan sistem", "error");
        }
      }

      async function fetchAndRenderSavings() {
        const menu = document.getElementById("dropdownMenu");

        try {
          const respone = await fetch("/savings/goals");
          const data = await respone.json();

          if (data.success && data.goals.length > 0) {
            menu.innerHTML = "";

            data.goals.forEach((goal) => {
              const item = document.createElement("div");
              item.className =
                "dropdown-item px-4 py-2.5 text-green-300 text-sm cursor-pointer border-b border-green-400/10 last:border-b-0 hover:bg-green-400/10 transition";
              item.textContent = goal.title;

              item.onclick = function () {
                document.getElementById("targetTabunganValue").value = goal.id;
                document.getElementById("selectedText").textContent =
                  goal.title;
                toggleDropdown();
              };

              menu.appendChild(item);
            });
          } else {
            menu.innerHTML =
              '<div class="px-4 py-3 text-gray-500 text-xs">Belum ada target.</div>';
          }
        } catch (err) {
          menu.innerHTML =
            '<div class="px-4 py-3 text-red-400 text-xs">Gagal memuat data.</div>';
        }
      }

      async function fetchAndRenderBalance() {
        try {
          const response = await fetch("/finance/balance-data");
          const result = await response.json();

          const formattedBalance = new Intl.NumberFormat("id-ID", {
            style: "currency",
            currency: "IDR",
            minimumFractionDigits: 0,
          }).format(result.balance);

          const formattedIncome = formatRupiahRingkas(result.income);
          const formattedExpense = formatRupiahRingkas(result.expense);

          const totalExpense = result.expense;
          const totalIncome = result.income;
          const totalBalance = result.balance;
          let point = 0;

          if (totalBalance > 0) {
            point += 40;
          }
          if (totalBalance > totalIncome * 0.2) {
            point += 30;
          }
          if (totalExpense < totalIncome * 0.5) {
            point += 20;
          }
          if (totalExpense < totalIncome * 0.2) {
            point += 10;
          }

          updateChartScore(point);

          if (formattedBalance < "Rp0") {
            document.getElementById("balance").classList.add("text-red-400");
            document
              .getElementById("balance")
              .classList.remove("text-green-400");
            document
              .getElementById("balance")
              .classList.remove("text-gray-400");
          } else {
            document.getElementById("balance").classList.add("text-green-400");
            document.getElementById("balance").classList.remove("text-red-400");
            document
              .getElementById("balance")
              .classList.remove("text-gray-400");
          }

          document.querySelectorAll("[id='balance']").forEach((el) => {
            el.innerHTML = formattedBalance;
          });

          document.querySelector("[id='totalPemasukan']").innerHTML =
            `+${formattedIncome}`;
          document.querySelector("[id='totalPengeluaran']").innerHTML =
            `-${formattedExpense}`;
        } catch (err) {
          console.error("Gagal mengambil data keuangan", err);
        }
      }
      fetchAndRenderBalance();
    </script>
  </body>
</html>
