<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Target Tabungan</title>
    <link rel="stylesheet" href="<%= env.CSS_URL %>">
    <% if (!env.IS_PRODUCTION) { %><script type="module" src="<%= env.BASEURL_VITE %>/@vite/client"></script><% } %>
    <link rel="stylesheet" href="/css/main.css">
    
    <style>
      #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .toast {
        background: #0f172a;
        border: 1px solid #22c55e;
        border-radius: 12px;
        padding: 12px 20px;
        color: white;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        animation: toastIn 0.3s ease-out;
      }

      @keyframes toastIn {
        from {
          transform: translateX(100%);
          opacity: 0;
        }
        to {
          transform: translateX(0);
          opacity: 1;
        }
      }
    </style>
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <%- include('components/sidebar') %>

    <!-- ================= MAIN ================= -->
    <main class="main-content flex-1 px-4 sm:px-8 xl:px-12 py-10 overflow-y-auto">
      <!-- HEADER -->
      <div  class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4"
      >
        <h1 class="text-3xl font-semibold tracking-wide">Target Tabungan</h1>

      </div>

      <!-- ================= CARD TARGET ================= -->
      <div class="bg-[#020617] border border-gray-800 rounded-2xl p-6 mb-6">
        <p class="text-sm text-gray-400 mb-4">Target Tabungan</p>

        <!-- ITEM -->
        <div id="goals-list" class="space-y-5">
          <p class="text-sm text-gray-500 italic">Memuat data target..</p>
        </div>
        <!-- <div id="goal-options" class="flex gap-3 overflow-x-auto pb-2 mb-5"> -->

        <!-- <button class="goal-btn flex items-center gap-2 px-4 py-2 rounded-xl bg-gray-800 hover:bg-gray-700 transition">
          <span class="text-sm">Laptop</span>
        </button>

        <button class="goal-btn flex items-center gap-2 px-4 py-2 rounded-xl bg-gray-800 hover:bg-gray-700 transition">
          <span class="text-sm">Motor</span>
        </button> -->

</div>
      </div>

      <!-- ================= KALENDER ================= -->
      <div class="bg-[#020617] border border-gray-800 rounded-2xl p-6 mb-6">
        <div class="flex justify-between mb-4">
          <p class="text-sm text-gray-400">Kalender</p>

          <div class="flex gap-2 text-xs">
            <span class="px-3 py-1 bg-gray-800 rounded">3 hari terakhir</span>
            <span class="px-3 py-1 bg-gray-800 rounded">7 hari terakhir</span>
            <span class="px-3 py-1 bg-green-500 text-black rounded"
              >30 hari terakhir</span
            >
            <span class="px-3 py-1 bg-gray-800 rounded">90 hari terakhir</span>
          </div>
        </div>

        <!-- GRID KALENDER -->
        <div id="calendar-grid" class="grid grid-cols-7 gap-2 text-center text-sm text-gray-400">
          <p class="col-span-7 py-10 text-gray-500 italic">Memuat data kalender..</p>
        </div>
      </div>

      <!-- ================= INFO ================= -->
      <div
        class="bg-green-500/10 border border-green-500/30 text-green-400 text-center py-4 rounded-xl"
      >
        Pilih target utama dan pantau progres tabunganmu secara berkala.
      </div>

      <div id="toast-container"></div>
    </main>
    <script>
      function escapeHtml(value) {
        return String(value).replace(/[&<>'"]/g, character => ({
          '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
        })[character]);
      }

      async function fetchAndRenderGoals() {
        const goalsList = document.getElementById('goals-list');
        if(!goalsList) return;

        try {
          const respone = await fetch('/savings/goals');
          const data = await respone.json();

          if(data.success && data.goals && data.goals.length > 0) {
            goalsList.innerHTML = '';

            data.goals.forEach(goal => {
              const target = parseFloat(goal.target_amount ) || 0;
              const current = parseFloat(goal.current_amount) || 0;
              const percentage = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;

              const barColor = percentage > 20 ? 'bg-green-400' : 'bg-yellow-400';
              const textColor = percentage > 20 ? 'text-green-400' : 'text-yellow-400';

              const goalItem = document.createElement('div');
              goalItem.className = 'mb-5';
              goalItem.innerHTML = `
                <div class="flex items-center justify-between gap-4 text-sm mb-1">
                  <span>${escapeHtml(goal.title)}</span>
                  <button class="goal-btn flex items-center gap-2 px-4 py-2 rounded-xl bg-gray-800 hover:bg-gray-700 transition" onclick="updateTarget(${goal.id})">
                        <span class="text-sm">${escapeHtml(goal.title)}</span>
                        <span class="${textColor}">${percentage}%</span>
                      </button>
                </div>


                <div class="w-full h-2 bg-gray-800 rounded-full">
                  <div class="h-2 ${barColor} rounded-full" style="width: ${percentage}%"></div>
                </div>

                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span class="${textColor}">${formatRupiah(current)}</span>
                  <span>dari ${formatRupiah(target)}</span>
                </div>
              `;
              goalsList.appendChild(goalItem);
            });
          } else {
            goalsList.innerHTML = '<p class="text-sm text-gray-500 italic">Belum ada target tabungan.</p>';
          }
        } catch (err) {
          console.error('Error fetching goals:', err);
          goalsList.innerHTML = '<p class="text-sm text-red-400 italic">Gagal memuat data.</p>';
        }
      }

      async function fetchAndRenderCalendar() {
        const grid = document.getElementById('calendar-grid');
        try {
          const response = await fetch('/savings/transactions');
          const result = await response.json();
          const savingData = {};

          if(result.success) {
            result.history.forEach(item => {
              savingData[item.day] = item.total_amount;
            });
          }

          const now = new Date();
          const year = now.getFullYear();
          const month = now.getMonth();
          const daysInMonth = new Date(year, month + 1, 0).getDate();

          let html = '';
          
          for(let i = 1; i <= daysInMonth; i++) {
            const amount = savingData[i];
            if(amount) {
              html += `
              <div class="p-3 bg-green-500/20 rounded text-green-400 border border-green-500/30">
                ${i}
                <div class="text-[10px] font-bold">${formatRupiah(amount)}</div>
              </div>`;
            } else {
              html += `<div class="p-3 border border-transparent">
                ${i}
                <div class="text-[10px] font-bold"></div>
              </div>`;
            }
          }
          grid.innerHTML = html;
        } catch (err) {
          console.error('Error fetching calendar:', err);
          grid.innerHTML = '<p class="col-span-7 py-10 text-red-400 italic">Gagal memuat data kalender.</p>';
        }
      }

      async function updateTarget(goalId) {
        const response = await fetch(`/savings/goals/${goalId}`, {
          method: 'PATCH'
        });

        if(response.ok) {
          showToast('Target tabungan berhasil diperbarui!', 'success');
          fetchAndRenderGoals();
        } else {
          showToast('Gagal memperbarui target tabungan. Silakan coba lagi.', 'error');
        }
      }

      function formatRupiah(amount) {
        return new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          minimumFractionDigits: 0
        }).format(amount);
      }

      function showToast(message, type = "success", duration = 5000) {
        const container = document.getElementById("toast-container");

        const toast = document.createElement("div");
        toast.className = `toast toast-${type}`;

        toast.innerHTML = `
    <span style="font-size:20px">
      ${type === "success" ? "✅" : "❌"}
    </span>

    <div style="flex:1">
      <div style="font-weight:600; margin-bottom:2px">
        ${type === "success" ? "Berhasil" : "Gagal"}
      </div>
      <div style="font-size:13px; color:var(--soft)">
        ${escapeHtml(message)}
      </div>
    </div>

    <button class="toast-close">✖</button>

    <div class="toast-progress"></div>
  `;

        const progress = toast.querySelector(".toast-progress");
        progress.style.animationDuration = duration + "ms";

        const closeBtn = toast.querySelector(".toast-close");

        closeBtn.onclick = () => removeToast(toast);

        container.appendChild(toast);

        const timeout = setTimeout(() => {
          removeToast(toast);
        }, duration);

        function removeToast(el) {
          el.style.animation = "toastOut 0.3s ease forwards";
          clearTimeout(timeout);
          setTimeout(() => el.remove(), 300);
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        fetchAndRenderGoals();
        fetchAndRenderCalendar();
      });
    </script>
  </body>
</html>
