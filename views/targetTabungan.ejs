<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Target Tabungan - PeakFinance</title>
    <link rel="stylesheet" href="<%= env.BASEURL_VITE %>/public/css/input.css">
    <script type="module" src="<%= env.BASEURL_VITE %>/@vite/client"></script>
    <link rel="stylesheet" href="/css/main.css">
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <%- include('components/sidebar') %>

    <!-- ================= MAIN ================= -->
    <main class="main-content">
      <!-- HEADER -->
      <div class="page-header">
        <div>
          <h1 class="page-title">Target Tabungan</h1>
          <p class="page-subtitle">Kelola tujuan dan pantau konsistensi menabungmu.</p>
        </div>

      </div>

      <!-- ================= CARD TARGET ================= -->
      <section class="finance-card p-4 sm:p-6 mb-6">
        <div class="section-heading">
          <div>
            <p class="font-semibold">Target aktif</p>
            <p class="text-xs text-gray-500 mt-1">Klik target untuk menjadikannya target utama.</p>
          </div>
        </div>

        <!-- ITEM -->
        <div id="goals-list" class="space-y-5">
          <p class="text-sm text-gray-500 italic">Memuat data target..</p>
        </div>
      </section>

      <!-- ================= KALENDER ================= -->
      <section class="finance-card p-4 sm:p-6 mb-6">
        <!-- Calendar header: label + filter buttons -->
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2 mb-4">
          <div>
            <p class="font-semibold">Kalender tabungan</p>
            <p id="currentMonthLabel" class="text-xs text-gray-500 mt-1"></p>
          </div>

          <span class="text-xs text-green-400 bg-green-500/10 border border-green-500/30 rounded-lg px-3 py-2">Bulan berjalan</span>
        </div>

        <!-- GRID KALENDER: scrollable on mobile -->
        <div class="overflow-x-auto -mx-1">
          <div id="calendar-grid" class="grid grid-cols-7 gap-1 text-center text-xs sm:text-sm text-gray-400 min-w-[320px]">
            <p class="col-span-7 py-10 text-gray-500 italic">Memuat data kalender..</p>
          </div>
        </div>
      </section>

      <!-- ================= INFO ================= -->
      <div
        class="bg-green-500/10 border border-green-500/30 text-green-400 text-center py-4 rounded-xl"
      >
        Setiap setoran kecil membawa targetmu semakin dekat.
      </div>

      <div id="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>
    </main>
    <script>
      document.getElementById('currentMonthLabel').textContent = new Intl.DateTimeFormat('id-ID', {
        month: 'long',
        year: 'numeric'
      }).format(new Date());

      async function fetchAndRenderGoals() {
        const goalsList = document.getElementById('goals-list');
        if(!goalsList) return;

        try {
          const respone = await fetch('/savings/goals');
          const data = await respone.json();

          if(data.success && data.goals && data.goals.length > 0) {
            goalsList.innerHTML = '';

            data.goals.forEach(goal => {
              const target = parseFloat(goal.target_amount ) || 0;
              const current = parseFloat(goal.current_amount) || 0;
              const percentage = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;

              const barColor = percentage > 20 ? 'bg-green-400' : 'bg-yellow-400';
              const textColor = percentage > 20 ? 'text-green-400' : 'text-yellow-400';

              const goalItem = document.createElement('div');
              goalItem.className = 'goal-item';
              goalItem.innerHTML = `
                <div class="goal-item-header">
                  <div class="min-w-0">
                    <p class="goal-title">${goal.title}</p>
                    <p class="text-xs text-gray-500 mt-1">${percentage}% tercapai</p>
                  </div>
                  <button class="goal-btn px-3 py-2 rounded-xl bg-gray-800 hover:bg-gray-700 transition" onclick="updateTarget(${goal.id})">
                    Jadikan utama
                  </button>
                </div>


                <div class="w-full h-2 bg-gray-800 rounded-full">
                  <div class="h-2 ${barColor} rounded-full" style="width: ${percentage}%"></div>
                </div>

                <div class="goal-amounts text-xs text-gray-400 mt-2">
                  <span class="${textColor}">${formatRupiah(current)}</span>
                  <span>dari ${formatRupiah(target)}</span>
                </div>
              `;
              goalsList.appendChild(goalItem);
            });
          } else {
            goalsList.innerHTML = '<p class="text-sm text-gray-500 italic">Belum ada target tabungan.</p>';
          }
        } catch (err) {
          console.error('Error fetching goals:', err);
          goalsList.innerHTML = '<p class="text-sm text-red-400 italic">Gagal memuat data.</p>';
        }
      }

      async function fetchAndRenderCalendar() {
        const grid = document.getElementById('calendar-grid');
        try {
          const response = await fetch('/savings/transactions');
          const result = await response.json();
          const savingData = {};

          if(result.success) {
            result.history.forEach(item => {
              savingData[item.day] = item.total_amount;
            });
          }

          const now = new Date();
          const year = now.getFullYear();
          const month = now.getMonth();
          const daysInMonth = new Date(year, month + 1, 0).getDate();

          let html = '';
          
          for(let i = 1; i <= daysInMonth; i++) {
            const amount = savingData[i];
            if(amount) {
              html += `
              <div class="p-1 sm:p-2 bg-green-500/20 rounded text-green-400 border border-green-500/30">
                ${i}
                <div class="text-[9px] sm:text-[10px] font-bold leading-tight">${formatRupiahCompact(amount)}</div>
              </div>`;
            } else {
              html += `<div class="p-1 sm:p-2 border border-transparent">
                ${i}
                <div class="text-[9px] sm:text-[10px] font-bold"></div>
              </div>`;
            }
          }
          grid.innerHTML = html;
        } catch (err) {
          console.error('Error fetching calendar:', err);
          grid.innerHTML = '<p class="col-span-7 py-10 text-red-400 italic">Gagal memuat data kalender.</p>';
        }
      }

      async function updateTarget(goalId) {
        const response = await fetch(`/savings/goals/${goalId}`, {
          method: 'PATCH'
        });

        if(response.ok) {
          showToast('Target tabungan berhasil diperbarui!', 'success');
          fetchAndRenderGoals();
        } else {
          showToast('Gagal memperbarui target tabungan. Silakan coba lagi.', 'error');
        }
      }

      function formatRupiah(amount) {
        return new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          minimumFractionDigits: 0
        }).format(amount);
      }

      function formatRupiahCompact(amount) {
        return new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          notation: 'compact',
          maximumFractionDigits: 1
        }).format(amount);
      }

      function showToast(message, type = "success", duration = 5000) {
        const container = document.getElementById("toast-container");

        const toast = document.createElement("div");
        toast.className = `toast toast-${type}`;

        toast.innerHTML = `
    <span style="font-size:20px">
      ${type === "success" ? "✅" : "❌"}
    </span>

    <div style="flex:1">
      <div style="font-weight:600; margin-bottom:2px">
        ${type === "success" ? "Berhasil" : "Gagal"}
      </div>
      <div style="font-size:13px; color:var(--app-muted)">
        ${message}
      </div>
    </div>

    <button class="toast-close">✖</button>

    <div class="toast-progress"></div>
  `;

        const progress = toast.querySelector(".toast-progress");
        progress.style.animationDuration = duration + "ms";

        const closeBtn = toast.querySelector(".toast-close");

        closeBtn.onclick = () => removeToast(toast);

        container.appendChild(toast);

        const timeout = setTimeout(() => {
          removeToast(toast);
        }, duration);

        function removeToast(el) {
          el.style.animation = "toastOut 0.3s ease forwards";
          clearTimeout(timeout);
          setTimeout(() => el.remove(), 300);
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        fetchAndRenderGoals();
        fetchAndRenderCalendar();
      });
    </script>
  </body>
</html>
