<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Target Tabungan</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- ================= SIDEBAR ================= -->
    <%- include('components/sidebar') %>

    <!-- ================= MAIN ================= -->
    <main class="main-content flex-1 px-12 py-10 overflow-y-auto">
      <!-- HEADER -->
      <div  class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4"
      >
        <h1 class="text-3xl font-semibold tracking-wide">Target Tabungan</h1>

      </div>

      <!-- ================= CARD TARGET ================= -->
      <div class="bg-[#020617] border border-gray-800 rounded-2xl p-6 mb-6">
        <p class="text-sm text-gray-400 mb-4">Target Tabungan</p>

        <!-- ITEM -->
        <div id="goals-list" class="space-y-5">
          <p class="text-sm text-gray-500 italic">Memuat data target..</p>
        </div>
      </div>

      <!-- ================= KALENDER ================= -->
      <div class="bg-[#020617] border border-gray-800 rounded-2xl p-6 mb-6">
        <div class="flex justify-between mb-4">
          <p class="text-sm text-gray-400">Kalender</p>

          <div class="flex gap-2 text-xs">
            <span class="px-3 py-1 bg-gray-800 rounded">3 hari terakhir</span>
            <span class="px-3 py-1 bg-gray-800 rounded">7 hari terakhir</span>
            <span class="px-3 py-1 bg-green-500 text-black rounded"
              >30 hari terakhir</span
            >
            <span class="px-3 py-1 bg-gray-800 rounded">90 hari terakhir</span>
          </div>
        </div>

        <!-- GRID KALENDER -->
        <div class="grid grid-cols-7 gap-2 text-center text-sm text-gray-400">
          <!-- tanggal -->
          <div class="p-3">1</div>
          <div class="p-3">2</div>
          <div class="p-3">3</div>
          <div class="p-3">4</div>
          <div class="p-3">5</div>
          <div class="p-3">6</div>
          <div class="p-3">7</div>

          <div class="p-3">8</div>
          <div class="p-3">9</div>
          <div class="p-3">10</div>
          <div class="p-3">11</div>
          <div class="p-3">12</div>
          <div class="p-3">13</div>
          <div class="p-3">14</div>

          <div class="p-3">15</div>
          <div class="p-3">16</div>
          <div class="p-3">17</div>
          <div class="p-3">18</div>
          <div class="p-3">19</div>
          <div class="p-3">20</div>
          <div class="p-3">21</div>

          <div class="p-3">22</div>
          <div class="p-3">23</div>
          <div class="p-3">24</div>
          <div class="p-3">25</div>
          <div class="p-3">26</div>
          <div class="p-3">27</div>
          <div class="p-3">28</div>

          <div class="p-3">29</div>

          <!-- HIGHLIGHT -->
          <div class="p-3 bg-green-500/20 rounded text-green-400">
            30
            <div class="text-[10px]">Rp1.500.000</div>
          </div>

          <div class="p-3">31</div>
        </div>
      </div>

      <!-- ================= INFO ================= -->
      <div
        class="bg-green-500/10 border border-green-500/30 text-green-400 text-center py-4 rounded-xl"
      >
        Target kamu dalam bulan ini adalah Rp1.500.000. Kerja bagus!
      </div>
    </main>
    <script>
      async function fetchAndRenderGoals() {
        const goalsList = document.getElementById('goals-list');
        if(!goalsList) return;

        try {
          const respone = await fetch('/savings/goals');
          const data = await respone.json();

          console.log("Data:", data);

          if(data.success && data.goals && data.goals.length > 0) {
            goalsList.innerHTML = '';

            data.goals.forEach(goal => {
              const target = parseFloat(goal.target_amount ) || 0;
              const current = parseFloat(goal.current_amount) || 0;
              const percentage = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;

              const barColor = percentage > 20 ? 'bg-green-400' : 'bg-yellow-400';
              const textColor = percentage > 20 ? 'text-green-400' : 'text-yellow-400';

              const goalItem = document.createElement('div');
              goalItem.className = 'mb-5';
              goalItem.innerHTML = `
                <div class="flex justify-between text-sm mb-1">
                  <span>${goal.title}</span>
                  <span class="${textColor}">${percentage}%</span>
                </div>

                <div class="w-full h-2 bg-gray-800 rounded-full">
                  <div class="h-2 ${barColor} rounded-full" style="width: ${percentage}%"></div>
                </div>

                <div class="flex justify-between text-xs text-gray-400 mt-1">
                  <span class="${textColor}">${formatRupiah(current)}</span>
                  <span>dari ${formatRupiah(target)}</span>
                </div>
              `;
              goalsList.appendChild(goalItem);
            });
          } else {
            goalsList.innerHTML = '<p class="text-sm text-gray-500 italic">Belum ada target tabungan.</p>';
          }
        } catch (err) {
          console.error('Error fetching goals:', err);
          goalsList.innerHTML = '<p class="text-sm text-red-400 italic">Gagal memuat data.</p>';
        }
      }

      function formatRupiah(amount) {
        return new Intl.NumberFormat('id-ID', {
          style: 'currency',
          currency: 'IDR',
          minimumFractionDigits: 0
        }).format(amount);
      }

      document.addEventListener('DOMContentLoaded', fetchAndRenderGoals);
    </script>
  </body>
</html>