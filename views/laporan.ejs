<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Laporan - PeakFinance</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]">

<!-- SIDEBAR -->
<%- include('components/sidebar') %>

<!-- MAIN -->
<main class="flex-1 px-12 py-10 h-screen ml-64">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4">
    <h1 class="text-3xl font-semibold tracking-wide">Laporan</h1>
  </div>

  <!-- SUMMARY -->
  <div class="grid grid-cols-3 gap-6 mb-10">

    <div class="p-6 rounded-2xl bg-[#020617] border border-gray-800">
      <p class="text-gray-400 text-sm">Total Pemasukan</p>
      <h2 class="text-2xl font-bold text-green-400">
        Rp <%= (typeof pemasukan !== 'undefined' ? pemasukan : 0).toLocaleString() %>
      </h2>
    </div>

    <div class="p-6 rounded-2xl bg-[#020617] border border-gray-800">
      <p class="text-gray-400 text-sm">Total Pengeluaran</p>
      <h2 class="text-2xl font-bold text-red-400">
        Rp <%= (typeof pengeluaran !== 'undefined' ? pengeluaran : 0).toLocaleString() %>
      </h2>
    </div>

    <div class="p-6 rounded-2xl bg-[#020617] border border-gray-800">
      <p class="text-gray-400 text-sm">Saldo Akhir</p>
      <h2 class="text-2xl font-bold text-blue-400">
        Rp <%= (typeof saldo !== 'undefined' ? saldo : 0).toLocaleString() %>
      </h2>
    </div>

  </div>

  <!-- TRANSAKSI -->
  <div class="bg-[#020617] border border-gray-800 rounded-2xl p-6">

    <h2 class="text-xl font-semibold mb-6">Riwayat Transaksi</h2>

    <div class="space-y-4">

      <% (typeof transaksi !== 'undefined' ? transaksi : []).forEach(t => { %>
        <div class="flex justify-between items-center border-b border-gray-800 pb-3">
          <div>
            <p class="font-medium"><%= t.nama %></p>
            <p class="text-xs text-gray-500"><%= t.tanggal %></p>
          </div>

          <p class="<%= t.tipe === 'masuk' ? 'text-green-400' : 'text-red-400' %> font-semibold">
            <%= t.tipe === 'masuk' ? '+' : '-' %> Rp <%= t.jumlah.toLocaleString() %>
          </p>
        </div>
      <% }) %>

    </div>

  </div>

</main>

</body>
</html>