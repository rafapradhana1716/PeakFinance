<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/auth.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <title>Daftar — PeakFinance</title>
</head>

<body class="auth-body">

    <!-- Background -->
    <div class="auth-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="grid-overlay"></div>
    </div>

    <div class="auth-wrapper">


        <!-- Left Panel -->
        <div class="auth-left">
            <div class="brand">
                <div class="brand-name">Peak<span>Finance</span></div>
            </div>
            <div class="auth-left-content">
                <h1 class="auth-left-title">Mulai perjalanan<br><span>finansialmu.</span></h1>
                <p class="auth-left-desc">Gratis selamanya untuk fitur dasar. Bergabung dan mulai kendalikan keuanganmu
                    sekarang.</p>
                <div class="auth-features">
                    <div class="af-item"><span class="af-icon">✅</span> Gratis, tanpa kartu kredit</div>
                    <div class="af-item"><span class="af-icon">🔒</span> Data kamu aman & terenkripsi</div>
                    <div class="af-item"><span class="af-icon">⚡</span> Setup selesai dalam 60 detik</div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Form -->
        <div class="auth-right">
            <div class="auth-card">

                <div class="auth-card-header">
                    <h2 class="auth-title">Buat akun baru</h2>
                    <p class="auth-subtitle">Isi data berikut untuk mulai</p>
                </div>

                <div class="form-server-error" id="server-error"></div>

                <form class="auth-form">

                    <div class="form-row-2">
                        <div class="form-group">
                            <label class="form-label" for="firstname">Nama Depan</label>
                            <div class="input-wrap">
                                <span class="input-icon">✏️</span>
                                <input class="form-input" type="text" id="firstname" name="firstname" placeholder="Jojo"
                                    autocomplete="off">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="lastname">Nama Belakang</label>
                            <div class="input-wrap">
                                <span class="input-icon">✏️</span>
                                <input class="form-input" type="text" id="lastname" name="lastname" placeholder="Willy"
                                    autocomplete="off">
                            </div>
                            <div class="form-error" id="error-lastname"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="reg-username">Username</label>
                        <div class="input-wrap">
                            <span class="input-icon">👤</span>
                            <input class="form-input" type="text" id="reg-username" name="username"
                                placeholder="JoWilly" autocomplete="off">
                        </div>
                        <div class="form-error" id="error-username"></div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="email">Email</label>
                        <div class="input-wrap">
                            <span class="input-icon">📧</span>
                            <input class="form-input" type="email" id="email" name="email" placeholder="nama@email.com"
                                autocomplete="off">
                        </div>
                        <div class="form-error" id="error-email"></div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="reg-password">Password</label>
                        <div class="input-wrap">
                            <span class="input-icon">🔑</span>
                            <input class="form-input" type="password" id="reg-password" name="password"
                                placeholder="Min. 8 karakter" autocomplete="off">
                            <button type="button" class="toggle-pw"
                                onclick="togglePassword('reg-password', this)">👁</button>
                        </div>
                        <div class="pw-strength" id="pw-strength">
                            <div class="pw-bar">
                                <div class="pw-fill" id="pw-fill"></div>
                            </div>
                            <span class="pw-label" id="pw-label">Kekuatan password</span>
                        </div>
                        <div class="form-error" id="error-password"></div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="confirm-password">Konfirmasi Password</label>
                        <div class="input-wrap">
                            <span class="input-icon">🔒</span>
                            <input class="form-input" type="password" id="confirm-password" name="confirm_password"
                                placeholder="Ulangi password" autocomplete="off">
                            <button type="button" class="toggle-pw"
                                onclick="togglePassword('confirm-password', this)">👁</button>
                        </div>
                        <div class="form-error" id="error-confirm-password"></div>
                    </div>

                    <label class="checkbox-label" style="margin-bottom:20px">
                        <input type="checkbox" class="checkbox-input" required>
                        <span class="checkbox-custom"></span>
                        Saya setuju dengan <a href="#" onclick="openSyarat(); return false;"
                            class="auth-switch-link">Syarat & Ketentuan</a>
                    </label>

                    <button type="submit" class="btn-submit">
                        Buat Akun <span class="btn-arrow">→</span>
                    </button>

                </form>

                <div class="auth-divider"><span>atau</span></div>

                <p class="auth-switch">
                    Sudah punya akun?
                    <a href="login" class="auth-switch-link">Masuk di sini</a>
                </p>

            </div>
        </div>
        <!-- Modal Syarat & Ketentuan -->
        <div id="modalSyarat" class="modal hidden">
            <div class="modal-content">

                <div class="modal-header">
                    <h3>Syarat & Ketentuan</h3>
                    <button onclick="closeSyarat()" class="modal-close">✖</button>
                </div>

                <div class="modal-body">
                    <p>
                        PeakFinance adalah aplikasi pencatat keuangan pribadi dan masih dalam tahap pengembangan. Dengan menggunakan aplikasi ini, kamu setuju bahwa:
                    </p>
                    <ul>
                        <li>PeakFinance hanya untuk mencatat dan memantau keuangan pribadi, bukan aplikasi transaksi, pembayaran, atau perbankan, dan tidak terhubung ke rekening bank manapun.</li>
                        <li>Data yang kamu masukkan (catatan pemasukan, pengeluaran, dll) sepenuhnya adalah tanggung jawabmu untuk memastikan keakuratannya.</li>
                        <li>Karena masih tahap pengembangan, fitur dan tampilan bisa berubah sewaktu-waktu, dan ada kemungkinan data hilang atau error,  jadi sebaiknya jangan jadikan ini satu-satunya tempat pencatatan keuanganmu untuk sementara.</li>
                        <li>Kami menjaga data kamu dengan sebaik mungkin, namun belum bisa menjamin keamanan penuh selama masa pengembangan ini.</li>
                        <li>Kami tidak bertanggung jawab atas keputusan finansial yang kamu ambil berdasarkan catatan di aplikasi ini, PeakFinance hanya alat bantu pencatatan, bukan penasihat keuangan.</li>
                    </ul>
                    <p>
                        Detail lengkap akan dikembangkan nanti sesuai kebutuhan aplikasi.
                    </p>
                </div>

                <div class="modal-footer">
                    <button onclick="setujuSyarat()" class="btn-submit">
                        Saya Setuju
                    </button>
                </div>

            </div>
        </div>

    </div>


    <script>
        const checkbox = document.querySelector('.checkbox-input');
        const btnSubmit = document.querySelector('.btn-submit');

        checkbox.addEventListener('change', () => {
            btnSubmit.classList.toggle('active', checkbox.checked);
        });

        function openSyarat() {
            const m = document.getElementById('modalSyarat');
            m.classList.remove('hidden');
            m.classList.add('flex');
        }

        function closeSyarat() {
            const m = document.getElementById('modalSyarat');
            m.classList.add('hidden');
            m.classList.remove('flex');
        }

        function setujuSyarat() {
            // Centang otomatis checkbox
            document.querySelector('.checkbox-input').checked = true;
            closeSyarat();
        }

        // Klik luar modal = tutup
        const modal = document.getElementById('modalSyarat');
        if (modal) {
            modal.addEventListener('click', function (e) {
                if (e.target === this) closeSyarat();
            });
        }

        function togglePassword(id, btn) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '⌣';
            } else {
                input.type = 'password';
                btn.textContent = '👁';
            }
        }

        // Password strength meter
        document.getElementById('reg-password').addEventListener('input', function () {
            const val = this.value;
            const fill = document.getElementById('pw-fill');
            const label = document.getElementById('pw-label');
            let strength = 0;
            if (val.length >= 8) strength++;
            if (/[A-Z]/.test(val)) strength++;
            if (/[0-9]/.test(val)) strength++;
            if (/[^A-Za-z0-9]/.test(val)) strength++;

            const configs = [
                { width: '0%', color: 'var(--border2)', text: 'Kekuatan password' },
                { width: '25%', color: 'var(--coral)', text: 'Lemah' },
                { width: '50%', color: 'var(--amber)', text: 'Cukup' },
                { width: '75%', color: 'var(--blue)', text: 'Kuat' },
                { width: '100%', color: 'var(--mint)', text: 'Sangat Kuat!' },
            ];
            const c = configs[strength];
            fill.style.width = c.width;
            fill.style.background = c.color;
            label.textContent = c.text;
            label.style.color = c.color;
        });

        // Handle form submission errors
        document.querySelector('.auth-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const firstname = document.getElementById('firstname');
            const lastname = document.getElementById('lastname');
            const username = document.getElementById('reg-username');
            const email = document.getElementById('email');
            const password = document.getElementById('reg-password');
            const confirmPassword = document.getElementById('confirm-password');
            const serverErrorEl = document.getElementById('server-error');
            let hasError = false;

            // Clear previous errors
            document.querySelectorAll('.form-error').forEach(el => {
                el.classList.remove('show');
                el.textContent = '';
            });
            document.querySelectorAll('.form-input').forEach(el => {
                el.classList.remove('error');
            });
            serverErrorEl.classList.remove('show');
            serverErrorEl.textContent = '';

            // Validate
            if (!firstname.value.trim()) {
                showError('firstname', 'Nama depan wajib diisi');
                hasError = true;
            }
            if (!lastname.value.trim()) {
                showError('lastname', 'Nama belakang wajib diisi');
                hasError = true;
            }
            if (!username.value.trim()) {
                showError('username', 'Username wajib diisi');
                hasError = true;
            }
            if (!email.value.trim()) {
                showError('email', 'Email wajib diisi');
                hasError = true;
            } else if (!/^\S+@\S+\.\S+$/.test(email.value)) {
                showError('email', 'Format email tidak valid');
                hasError = true;
            }
            if (!password.value.trim()) {
                showError('password', 'Password wajib diisi');
                hasError = true;
            } else if (password.value.length < 8) {
                showError('password', 'Password minimal 8 karakter');
                hasError = true;
            }
            if (!confirmPassword.value.trim()) {
                showError('confirm-password', 'Konfirmasi password wajib diisi');
                hasError = true;
            } else if (password.value !== confirmPassword.value) {
                showError('confirm-password', 'Password tidak sesuai');
                hasError = true;
            }

            if (!hasError) {
                try {
                    const response = await fetch('/auth/register', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            firstname: firstname.value,
                            lastname: lastname.value,
                            username: username.value,
                            email: email.value,
                            password: password.value
                        })
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        serverErrorEl.textContent = data.message;
                        serverErrorEl.classList.add('show');
                    } else {
                        window.location.href = '/';
                    }
                } catch (error) {
                    console.error('Error:', error);
                    serverErrorEl.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
                    serverErrorEl.classList.add('show');
                }
            }
        });

        function showError(fieldId, message) {
            const input = document.getElementById(fieldId);
            const errorEl = document.getElementById('error-' + fieldId);
            if (errorEl) {
                errorEl.textContent = message;
                errorEl.classList.add('show');
                input.classList.add('error');
            }
        }

        // Clear error when user starts typing
        document.querySelectorAll('.form-input').forEach(input => {
            input.addEventListener('input', function() {
                const errorId = 'error-' + this.id;
                const errorEl = document.getElementById(errorId);
                if (errorEl) {
                    errorEl.classList.remove('show');
                    this.classList.remove('error');
                }
            });
        });
    </script>
</body>

</html>
