<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/auth.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <title>Login — Peak Finance</title>
    <link rel="icon" type="image/svg+xml" href="/public/peakfinance-icon-brand%201.svg">
</head>

<body class="auth-body">

    <!-- Background -->
    <div class="auth-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="grid-overlay"></div>
    </div>

    <div class="auth-wrapper">

        <!-- Left Panel -->
        <div class="auth-left">
            <div class="brand">
                <div class="brand-name">Peak<span>Finance</span></div>
            </div>
            <div class="auth-left-content">
                <h1 class="auth-left-title">Kontrol uangmu,<br><span>capai puncaknya.</span></h1>
                <p class="auth-left-desc">Lacak pengeluaran, bangun kebiasaan finansial sehat, dan capai target
                    tabunganmu — mulai hari ini.</p>
                <div class="auth-features">
                    <div class="af-item"><span class="af-icon">📊</span> Analisis pengeluaran otomatis</div>
                    <div class="af-item"><span class="af-icon">🎯</span> Target tabungan terstruktur</div>
                    <div class="af-item"><span class="af-icon">💡</span> Insight & rekomendasi cerdas</div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Form -->
        <div class="auth-right">
            <div class="auth-card">

                <div class="auth-card-header">
                    <h2 class="auth-title">Selamat datang kembali</h2>
                    <p class="auth-subtitle">Masuk ke akun PeakFinance kamu</p>
                </div>

                <div class="form-server-error" id="server-error"></div>

                <form class="auth-form">

                    <div class="form-group">
                        <label class="form-label" for="username">Username</label>
                        <div class="input-wrap">
                            <span class="input-icon">👤</span>
                            <input class="form-input" type="text" id="username" name="username"
                                placeholder="Masukkan email atau username" autocomplete="off">
                        </div>
                        <div class="form-error" id="error-username"></div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">Password</label>
                        <div class="input-wrap">
                            <span class="input-icon">🔑</span>
                            <input class="form-input" type="password" id="password" name="password"
                                placeholder="Masukkan password" autocomplete="off">
                            <button type="button" class="toggle-pw"
                                onclick="togglePassword('password', this)">👁</button>
                        </div>
                        <div class="form-error" id="error-password"></div>
                    </div>

                    <div class="form-row">
                        <label class="checkbox-label">
                            <input type="checkbox" name="rememberMe" class="checkbox-input" id="checkbox-remember" value="true">
                            <span class="checkbox-custom"></span>
                            Ingat saya
                        </label>
                        <a href="#" class="forgot-link">Lupa password?</a>
                    </div>

                    <button type="submit" id="login" class="loginBtn-submit">
                        Masuk <span class="loginBtn-arrow">→</span>
                    </button>

                </form>

                <div class="auth-divider"><span>atau</span></div>

                <p class="auth-switch">
                    Belum punya akun?
                    <a href="register" class="auth-switch-link">Daftar sekarang</a>
                </p>

            </div>
        </div>

    </div>

    <script>
        function togglePassword(id, btn) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '⌣';
            } else {
                input.type = 'password';
                btn.textContent = '👁';
            }
        }

        // Handle form submission errors
        document.querySelector('.auth-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const username = document.getElementById('username');
            const password = document.getElementById('password');
            const rememberMe = document.getElementById('checkbox-remember');
            const serverErrorEl = document.getElementById('server-error');
            let hasError = false;

            // Clear previous errors
            document.querySelectorAll('.form-error').forEach(el => {
                el.classList.remove('show');
                el.textContent = '';
            });
            document.querySelectorAll('.form-input').forEach(el => {
                el.classList.remove('error');
            });
            serverErrorEl.classList.remove('show');
            serverErrorEl.textContent = '';

            // Validate
            if (!username.value.trim()) {
                showError('username', 'Username atau email wajib diisi');
                hasError = true;
            }
            if (!password.value.trim()) {
                showError('password', 'Password wajib diisi');
                hasError = true;
            }

            if (!hasError) {
                try {
                    const response = await fetch('/auth/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            username: username.value,
                            password: password.value,
                            rememberMe: rememberMe.checked
                        })
                    });

                    const data = await response.json();

                    if (!response.ok) {
                        serverErrorEl.textContent = data.message;
                        serverErrorEl.classList.add('show');
                    } else {
                        window.location.href = '/';
                    }
                } catch (error) {
                    console.error('Error:', error);
                    serverErrorEl.textContent = 'Terjadi kesalahan. Silakan coba lagi.';
                    serverErrorEl.classList.add('show');
                }
            }
        });

        function showError(fieldId, message) {
            const input = document.getElementById(fieldId);
            const errorEl = document.getElementById('error-' + fieldId);
            if (errorEl) {
                errorEl.textContent = message;
                errorEl.classList.add('show');
                input.classList.add('error');
            }
        }

        // Clear error when user starts typing
        document.querySelectorAll('.form-input').forEach(input => {
            input.addEventListener('input', function() {
                const errorId = 'error-' + this.id;
                const errorEl = document.getElementById(errorId);
                if (errorEl) {
                    errorEl.classList.remove('show');
                    this.classList.remove('error');
                }
            });
        });
    </script>
</body>

</html>
