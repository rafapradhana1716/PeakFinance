<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/auth.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <title>Login — Peak Finance</title>
</head>

<body class="auth-body">

    <!-- Background -->
    <div class="auth-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="grid-overlay"></div>
    </div>

    <div class="auth-wrapper">

        <!-- Left Panel -->
        <div class="auth-left">
            <div class="brand">
                <div class="brand-name">Peak<span>Finance</span></div>
            </div>
            <div class="auth-left-content">
                <h1 class="auth-left-title">Kontrol uangmu,<br><span>capai puncaknya.</span></h1>
                <p class="auth-left-desc">Lacak pengeluaran, bangun kebiasaan finansial sehat, dan capai target
                    tabunganmu — mulai hari ini.</p>
                <div class="auth-features">
                    <div class="af-item"><span class="af-icon">📊</span> Analisis pengeluaran otomatis</div>
                    <div class="af-item"><span class="af-icon">🎯</span> Target tabungan terstruktur</div>
                    <div class="af-item"><span class="af-icon">💡</span> Insight & rekomendasi cerdas</div>
                </div>
            </div>
        </div>

        <!-- Right Panel: Form -->
        <div class="auth-right">
            <div class="auth-card">

                <div class="auth-card-header">
                    <h2 class="auth-title">Selamat datang kembali</h2>
                    <p class="auth-subtitle">Masuk ke akun Peak Finance kamu</p>
                </div>

                <form action="login" method="GET" class="auth-form">

                    <div class="form-group">
                        <label class="form-label" for="username">Username</label>
                        <div class="input-wrap">
                            <span class="input-icon">👤</span>
                            <input class="form-input" type="text" id="username" name="username"
                                placeholder="Masukkan username" autocomplete="off">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">Password</label>
                        <div class="input-wrap">
                            <span class="input-icon">🔑</span>
                            <input class="form-input" type="password" id="password" name="password"
                                placeholder="Masukkan password" autocomplete="off">
                            <button type="button" class="toggle-pw"
                                onclick="togglePassword('password', this)">👁</button>
                        </div>
                    </div>

                    <div class="form-row">
                        <label class="checkbox-label">
                            <input type="checkbox" class="checkbox-input">
                            <span class="checkbox-custom"></span>
                            Ingat saya
                        </label>
                        <a href="#" class="forgot-link">Lupa password?</a>
                    </div>

                    <button type="submit" id="login" class="btn-submit">
                        Masuk <span class="btn-arrow">→</span>
                    </button>

                </form>

                <div class="auth-divider"><span>atau</span></div>

                <p class="auth-switch">
                    Belum punya akun?
                    <a href="register.html" class="auth-switch-link">Daftar sekarang</a>
                </p>

            </div>
        </div>

    </div>

    <script>
        function togglePassword(id, btn) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                btn.textContent = '🙈';
            } else {
                input.type = 'password';
                btn.textContent = '👁';
            }
        }
    </script>
</body>

</html>