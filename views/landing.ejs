<!-- ── HOW IT WORKS ── -->
<section class="how" id="how">
  <div class="how-inner">
    <div class="section-label">Cara Kerja</div>
    <h2 class="section-title">Mulai dalam 60 detik</h2>
    <div class="steps">
      <div class="step-item">
        <div class="step-circle">1</div>
        <div class="step-title">Daftar Gratis</div>
        <div class="step-desc">Buat akun dalam hitungan detik, tanpa perlu kartu kredit atau rekening bank.</div>
      </div>
      <div class="step-item">
        <div class="step-circle">2</div>
        <div class="step-title">Catat Transaksi</div>
        <div class="step-desc">Input pemasukan dan pengeluaranmu dengan mudah — pilih kategori, masukkan nominal, selesai.</div>
      </div>
      <div class="step-item">
        <div class="step-circle">3</div>
        <div class="step-title">Lihat Analisis</div>
        <div class="step-desc">Peak Finance otomatis menganalisis pola keuanganmu dan menampilkan insight yang mudah dipahami.</div>
      </div>
      <div class="step-item">
        <div class="step-circle">4</div>
        <div class="step-title">Capai Target</div>
        <div class="step-desc">Ikuti rekomendasi Peak Finance dan pantau progres tabunganmu menuju target impian.</div>
      </div>
    </div>
  </div>
