<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Pengaturan - PeakFinance</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/main.css" />
    <style>
      #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .toast {
        background: #000000;
        border: 1px solid #22c55e;
        border-radius: 12px;
        padding: 12px 20px;
        color: white;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        animation: toastIn 0.3s ease-out;
      }

      @keyframes toastIn {
        from {
          transform: translateX(100%);
          opacity: 0;
        }
        to {
          transform: translateX(0);
          opacity: 1;
        }
      }
    </style>
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- SIDEBAR -->
    <%- include('components/sidebar') %>

    <!-- MAIN -->
    <main class="main-content flex-1 px-12 py-10 overflow-y-auto">
      <!-- HEADER -->
      <div
        class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4"
      >
        <h1 class="text-3xl font-semibold">Pengaturan</h1>
      </div>

      <!-- CONTENT -->
      <div class="flex-col">
        <!-- MENU KIRI -->
        <div class="flex w-64 space-y-3 gap-3">
          <button
            class="menu-btn w-full text-left px-4 py-2 bg-green-500/20 text-green-400 rounded-lg"
            data-menu="tampilan"
          >
            Tampilan
          </button>

          <button
            class="menu-btn w-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="aksesibilitas"
          >
            Aksesibilitas
          </button>

          <button
            class="menu-btn w-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="akun"
          >
            Akun
          </button>

          <button
            class="menu-btn w-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="bahasa"
          >
            Bahasa
          </button>

          <button
            class="menu-btn w-full h-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="personalisasi"
          >
            Personalisasi
          </button>
        </div>

        <div
          class="flex-1 bg-[#020617] border border-gray-800 rounded-2xl p-6 relative"
        >
          <!-- TAMPILAN PANEL -->
          <div id="tampilan" class="menu-content hidden">
            <p class="text-gray-500 text-sm">
              Fitur tampilan akan dikembangkan
            </p>
          </div>

          <!-- AKSESIBILITAS PANEL -->
          <div id="aksesibilitas" class="menu-content hidden">
            <p class="text-gray-500 text-sm">
              Fitur aksesibilitas akan dikembangkan
            </p>
          </div>

          <!-- AKUN PANEL -->
          <div id="akun" class="menu-content hidden">
            <div class="space-y-6">
              <div>
                <h2 class="text-xl font-semibold mb-4">Akun</h2>
                <p class="text-gray-400 mb-6">Kelola pengaturan akun Anda</p>

                <div class="account-editor flex items-center gap-4">
                  <div
                    class="avatar w-24 h-24 flex items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 text-black font-bold"
                  >
                    <i class="text-2xl fa-solid fa-user"></i>
                  </div>
                  <div class="flex-1 space-y-3 px-4 py-2">
                    <input
                      type="text"
                      id="firstName"
                      placeholder="First Name"
                      class="bg-[#020617] border border-gray-800 rounded-lg px-4 py-2 w-64 text-gray-400"
                    />

                    <input
                      type="text"
                      id="lastName"
                      placeholder="Last Name"
                      class="bg-[#020617] border border-gray-800 rounded-lg px-4 py-2 w-64 text-gray-400"
                    />

                    <button type="button" onclick="changeName()" class="px-4 py-2 bg-blue-500/20 text-blue-400 rounded-lg border border-blue-500/30 hover:bg-blue-500/30 transition">
                      Save Changes
                    </button>
                  </div>
                </div>
              </div>

              <div class="border-t border-gray-700 pt-6">
                <h3 class="text-sm font-semibold text-gray-300 mb-4">
                  Keamanan
                </h3>
                <form id="logoutForm" method="POST" action="/auth/logout">
                  <button
                    type="submit"
                    class="px-4 py-2 bg-red-500/20 text-red-400 rounded-lg border border-red-500/30 hover:bg-red-500/30 transition"
                  >
                    Logout
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- BAHASA PANEL -->
          <div id="bahasa" class="menu-content hidden">
            <p class="text-gray-500 text-sm">Fitur bahasa akan dikembangkan</p>
          </div>

          <!-- PERSONALISASI PANEL -->
          <div id="personalisasi" class="menu-content hidden">
            <p class="text-gray-500 text-sm">
              Fitur personalisasi akan dikembangkan
            </p>
          </div>

          <!-- PANEL KOSONG (DEFAULT) -->
          <div
            id="empty"
            class="menu-content w-full h-[300px] rounded-xl bg-[#020617] border border-gray-800 flex items-center justify-center"
          >
            <p class="text-gray-500 text-sm">Pilih menu pengaturan di kiri</p>
          </div>
        </div>
      </div>
    </main>
    <div id="toast-container"></div>
    <script>
      // Menu handler
      const menuButtons = document.querySelectorAll(".menu-btn");
      const menuContents = document.querySelectorAll(".menu-content");

      menuButtons.forEach((button) => {
        button.addEventListener("click", function () {
          const menuId = this.getAttribute("data-menu");

          // Hide all contents
          menuContents.forEach((content) => {
            content.classList.add("hidden");
          });

          // Remove active state from all buttons
          menuButtons.forEach((btn) => {
            btn.classList.remove("bg-green-500/20", "text-green-400");
            btn.classList.add(
              "bg-[#020617]",
              "border",
              "border-gray-800",
              "hover:bg-[#0b1220]",
            );
          });

          // Show selected content
          const selectedContent = document.getElementById(menuId);
          if (selectedContent) {
            selectedContent.classList.remove("hidden");
          }

          // Set button as active
          this.classList.remove(
            "bg-[#020617]",
            "border",
            "border-gray-800",
            "hover:bg-[#0b1220]",
          );
          this.classList.add("bg-green-500/20", "text-green-400");
        });
      });

      function changeName() {
        const firstName = document.getElementById("firstName").value;
        const lastName = document.getElementById("lastName").value;

        fetch("/auth/change-name", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ firstname: firstName, lastname: lastName }),
        }).then((response) => {
          if (response.ok) {
            showToast("Name updated successfully!", "success");
          } else {
            showToast("Failed to update name.", "error");
          }
        }).catch((error) => {
          console.error("Error:", error);
          showToast("Internal Server Error", "error");
        });
      }

      function showToast(message, type = "success", duration = 5000) {
        const container = document.getElementById("toast-container");

        const toast = document.createElement("div");
        toast.className = `toast toast-${type}`;

        toast.innerHTML = `
    <span style="font-size:20px">
      ${type === "success" ? "✅" : "❌"}
    </span>

    <div style="flex:1">
      <div style="font-weight:600; margin-bottom:2px">
        ${type === "success" ? "Berhasil" : "Gagal"}
      </div>
      <div style="font-size:13px; color:var(--soft)">
        ${message}
      </div>
    </div>

    <button class="toast-close">✖</button>

    <div class="toast-progress"></div>
  `;

        const progress = toast.querySelector(".toast-progress");
        progress.style.animationDuration = duration + "ms";

        const closeBtn = toast.querySelector(".toast-close");

        closeBtn.onclick = () => removeToast(toast);

        container.appendChild(toast);

        const timeout = setTimeout(() => {
          removeToast(toast);
        }, duration);

        function removeToast(el) {
          el.style.animation = "toastOut 0.3s ease forwards";
          clearTimeout(timeout);
          setTimeout(() => el.remove(), 300);
        }
      }

      // Show default (empty) on page load
      document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("empty").classList.remove("hidden");
      });
    </script>
  </body>
</html>
