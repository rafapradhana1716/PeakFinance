<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Pengaturan - PeakFinance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/lainnya.css">
</head>

<body class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]">

<!-- SIDEBAR -->
<%- include('components/sidebar') %>

<!-- MAIN -->
<main class="main-content flex-1 px-12 py-10 overflow-y-auto">

  <!-- HEADER -->
  <div class="flex justify-between items-center mb-8 border-b border-gray-800 pb-4">
    <h1 class="text-3xl font-semibold">Pengaturan</h1>
  </div>

  <!-- CONTENT -->
  <div class="flex gap-6">

    <!-- MENU KIRI -->
    <div class="w-64 space-y-3">

      <button class="w-full text-left px-4 py-2 bg-green-500/20 text-green-400 rounded-lg">
        Tampilan
      </button>

      <button class="w-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]">
        Aksesibilitas
      </button>

      <button class="w-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]">
        Akun
      </button>

      <button class="w-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]">
        Bahasa
      </button>

      <button class="w-full text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]">
        Personalisasi
      </button>

    </div>

   <div class="flex-1 bg-[#020617] border border-gray-800 rounded-2xl p-6">
  
  <!-- PANEL KOSONG -->
  <div class="w-full h-[300px] rounded-xl bg-[#020617] border border-gray-800 flex items-center justify-center">
    <p class="text-gray-500 text-sm">Pilih menu pengaturan di kiri</p>
  </div>

</div>

  </div>

</main>

</body>
</html>