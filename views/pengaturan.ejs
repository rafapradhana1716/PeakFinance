<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pengaturan - PeakFinance</title>
    <link rel="stylesheet" href="<%= env.BASEURL_VITE %>/public/css/input.css">
    <script type="module" src="<%= env.BASEURL_VITE %>/@vite/client"></script>
    <link rel="stylesheet" href="/css/main.css" />
  </head>

  <body class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]">
    <%- include('components/sidebar') %>

    <main class="main-content">
      <div class="page-header settings-page-heading">
        <div>
          <p class="settings-eyebrow"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Preferensi aplikasi</p>
          <h1 class="page-title" data-i18n="settingsTitle">Pengaturan</h1>
          <p class="page-subtitle" data-i18n="settingsSubtitle">Sesuaikan pengalaman dan kelola akunmu.</p>
        </div>
        <div class="settings-save-state" aria-live="polite">
          <span class="settings-save-dot"></span>
          Tersimpan otomatis di perangkat ini
        </div>
      </div>

      <div class="settings-layout">
        <div class="settings-tabs mobile-scroll-row" role="tablist" aria-label="Kategori pengaturan">
          <button class="menu-btn is-active" data-menu="tampilan" role="tab" aria-controls="tampilan" aria-selected="true">
            <i class="fa-solid fa-palette" aria-hidden="true"></i><span data-i18n="tabAppearance">Tampilan</span>
          </button>
          <button class="menu-btn" data-menu="aksesibilitas" role="tab" aria-controls="aksesibilitas" aria-selected="false" tabindex="-1">
            <i class="fa-solid fa-universal-access" aria-hidden="true"></i><span data-i18n="tabAccessibility">Aksesibilitas</span>
          </button>
          <button class="menu-btn" data-menu="akun" role="tab" aria-controls="akun" aria-selected="false" tabindex="-1">
            <i class="fa-solid fa-user-shield" aria-hidden="true"></i><span data-i18n="tabAccount">Akun</span>
          </button>
          <button class="menu-btn" data-menu="bahasa" role="tab" aria-controls="bahasa" aria-selected="false" tabindex="-1">
            <i class="fa-solid fa-language" aria-hidden="true"></i><span data-i18n="tabLanguage">Bahasa</span>
          </button>
          <button class="menu-btn" data-menu="personalisasi" role="tab" aria-controls="personalisasi" aria-selected="false" tabindex="-1">
            <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i><span data-i18n="tabPersonalization">Personalisasi</span>
          </button>
        </div>

        <div class="settings-panel">
          <section id="tampilan" class="menu-content" role="tabpanel">
            <div class="settings-panel-header">
              <div><span class="settings-panel-icon"><i class="fa-solid fa-palette"></i></span></div>
              <div><h2>Tampilan</h2><p>Atur warna dan kepadatan antarmuka sesuai perangkatmu.</p></div>
            </div>

            <fieldset class="settings-group">
              <legend>Tema warna</legend>
              <p class="settings-help">Pilih karakter visual yang paling nyaman untuk dipakai lama.</p>
              <div class="settings-option-grid settings-theme-grid">
                <label class="settings-choice">
                  <input type="radio" name="theme" value="midnight" data-preference="theme" />
                  <span class="settings-choice-content"><span class="theme-swatch theme-midnight"></span><strong>Midnight</strong><small>Biru gelap khas PeakFinance</small></span>
                </label>
                <label class="settings-choice">
                  <input type="radio" name="theme" value="oled" data-preference="theme" />
                  <span class="settings-choice-content"><span class="theme-swatch theme-oled"></span><strong>OLED Black</strong><small>Hitam pekat, hemat layar OLED</small></span>
                </label>
                <label class="settings-choice">
                  <input type="radio" name="theme" value="slate" data-preference="theme" />
                  <span class="settings-choice-content"><span class="theme-swatch theme-slate"></span><strong>Slate</strong><small>Netral dengan kontras lembut</small></span>
                </label>
              </div>
            </fieldset>

            <fieldset class="settings-group">
              <legend>Kepadatan konten</legend>
              <p class="settings-help">Mode ringkas menampilkan lebih banyak data dalam satu layar.</p>
              <div class="settings-segmented">
                <label><input type="radio" name="density" value="comfortable" data-preference="density" /><span><i class="fa-solid fa-expand"></i> Nyaman</span></label>
                <label><input type="radio" name="density" value="compact" data-preference="density" /><span><i class="fa-solid fa-compress"></i> Ringkas</span></label>
              </div>
            </fieldset>

            <div class="settings-preview" aria-label="Pratinjau tampilan">
              <div><small>PRATINJAU</small><strong>Saldo bulan ini</strong><span>Rp 12.480.000</span></div>
              <div class="settings-preview-chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
            </div>
          </section>

          <section id="aksesibilitas" class="menu-content hidden" role="tabpanel" hidden>
            <div class="settings-panel-header">
              <div><span class="settings-panel-icon"><i class="fa-solid fa-universal-access"></i></span></div>
              <div><h2>Aksesibilitas</h2><p>Sesuaikan keterbacaan dan gerakan agar aplikasi lebih nyaman.</p></div>
            </div>

            <fieldset class="settings-group">
              <legend>Ukuran teks</legend>
              <p class="settings-help">Perubahan diterapkan ke semua halaman aplikasi.</p>
              <div class="settings-segmented font-size-options">
                <label><input type="radio" name="fontSize" value="small" data-preference="fontSize" /><span><b class="font-small">A</b> Kecil</span></label>
                <label><input type="radio" name="fontSize" value="normal" data-preference="fontSize" /><span><b class="font-normal">A</b> Normal</span></label>
                <label><input type="radio" name="fontSize" value="large" data-preference="fontSize" /><span><b class="font-large">A</b> Besar</span></label>
              </div>
            </fieldset>

            <div class="settings-group settings-toggle-list">
              <label class="settings-toggle-row">
                <span><strong>Kurangi animasi</strong><small>Meminimalkan transisi dan pergerakan visual.</small></span>
                <input type="checkbox" data-preference="reducedMotion" /><i class="settings-switch" aria-hidden="true"></i>
              </label>
              <label class="settings-toggle-row">
                <span><strong>Kontras tinggi</strong><small>Mempertegas teks, garis, dan komponen penting.</small></span>
                <input type="checkbox" data-preference="highContrast" /><i class="settings-switch" aria-hidden="true"></i>
              </label>
              <label class="settings-toggle-row">
                <span><strong>Garis bawahi tautan</strong><small>Membuat elemen yang dapat diklik lebih mudah dikenali.</small></span>
                <input type="checkbox" data-preference="underlineLinks" /><i class="settings-switch" aria-hidden="true"></i>
              </label>
            </div>
          </section>

          <section id="akun" class="menu-content hidden" role="tabpanel" hidden>
            <div class="settings-panel-header">
              <div><span class="settings-panel-icon"><i class="fa-solid fa-user-shield"></i></span></div>
              <div><h2>Akun</h2><p>Kelola identitas dan sesi akun PeakFinance.</p></div>
            </div>
            <div class="settings-group account-editor">
              <div class="avatar account-avatar"><i class="fa-solid fa-user"></i></div>
              <div class="account-fields">
                <div class="settings-field-grid">
                  <label><span>Nama depan</span><input type="text" id="firstName" autocomplete="given-name" placeholder="Nama depan" /></label>
                  <label><span>Nama belakang</span><input type="text" id="lastName" autocomplete="family-name" placeholder="Nama belakang" /></label>
                </div>
                <button id="saveNameButton" type="button" onclick="changeName()" class="settings-primary-button"><i class="fa-solid fa-floppy-disk"></i> Simpan perubahan</button>
              </div>
            </div>
            <div class="settings-group danger-zone">
              <div><strong>Keluar dari akun</strong><p>Sesi pada browser ini akan diakhiri.</p></div>
              <form id="logoutForm" method="POST" action="/auth/logout"><button type="submit" class="settings-danger-button"><i class="fa-solid fa-arrow-right-from-bracket"></i> Keluar</button></form>
            </div>
          </section>

          <section id="bahasa" class="menu-content hidden" role="tabpanel" hidden>
            <div class="settings-panel-header">
              <div><span class="settings-panel-icon"><i class="fa-solid fa-language"></i></span></div>
              <div><h2>Bahasa</h2><p>Pilih bahasa utama untuk navigasi dan judul halaman.</p></div>
            </div>
            <fieldset class="settings-group">
              <legend>Bahasa antarmuka</legend>
              <p class="settings-help">Format angka dan mata uang tetap menggunakan Rupiah.</p>
              <div class="settings-option-grid language-grid">
                <label class="settings-choice">
                  <input type="radio" name="language" value="id" data-preference="language" />
                  <span class="settings-choice-content language-choice"><b>ID</b><span><strong>Bahasa Indonesia</strong><small>Bahasa utama</small></span></span>
                </label>
                <label class="settings-choice">
                  <input type="radio" name="language" value="en" data-preference="language" />
                  <span class="settings-choice-content language-choice"><b>EN</b><span><strong>English</strong><small>Navigation and page headings</small></span></span>
                </label>
              </div>
              <div class="settings-note"><i class="fa-solid fa-circle-info"></i><p>Konten transaksi yang kamu tulis sendiri tidak akan diterjemahkan.</p></div>
            </fieldset>
          </section>

          <section id="personalisasi" class="menu-content hidden" role="tabpanel" hidden>
            <div class="settings-panel-header">
              <div><span class="settings-panel-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span></div>
              <div><h2>Personalisasi</h2><p>Tentukan informasi dan perilaku aplikasi yang paling relevan bagimu.</p></div>
            </div>
            <div class="settings-group settings-toggle-list">
              <label class="settings-toggle-row">
                <span><strong>Sembunyikan nominal sensitif</strong><small>Menyamarkan saldo dan nominal saat aplikasi dibuka di tempat umum.</small></span>
                <input type="checkbox" data-preference="hideBalances" /><i class="settings-switch" aria-hidden="true"></i>
              </label>
              <label class="settings-toggle-row">
                <span><strong>Tampilkan insight di Dashboard</strong><small>Menampilkan rekomendasi dan ringkasan kebiasaan finansial.</small></span>
                <input type="checkbox" data-preference="showInsights" /><i class="settings-switch" aria-hidden="true"></i>
              </label>
              <label class="settings-toggle-row">
                <span><strong>Sidebar ringkas di desktop</strong><small>Menyisakan ikon agar area konten menjadi lebih luas.</small></span>
                <input type="checkbox" data-preference="sidebarCollapsed" /><i class="settings-switch" aria-hidden="true"></i>
              </label>
            </div>
            <fieldset class="settings-group">
              <legend>Periode data bawaan</legend>
              <p class="settings-help">Dipakai saat membuka halaman Analisis dan Transaksi.</p>
              <div class="settings-segmented">
                <label><input type="radio" name="defaultPeriod" value="7" data-preference="defaultPeriod" /><span>7 hari</span></label>
                <label><input type="radio" name="defaultPeriod" value="30" data-preference="defaultPeriod" /><span>30 hari</span></label>
                <label><input type="radio" name="defaultPeriod" value="90" data-preference="defaultPeriod" /><span>90 hari</span></label>
              </div>
            </fieldset>
            <div class="settings-reset-row">
              <div><strong>Kembalikan preferensi</strong><p>Menghapus penyesuaian lokal dan memakai nilai bawaan.</p></div>
              <button id="resetPreferences" type="button" class="settings-secondary-button"><i class="fa-solid fa-rotate-left"></i> Reset</button>
            </div>
          </section>
        </div>
      </div>
    </main>

    <div id="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      const menuButtons = [...document.querySelectorAll('.menu-btn')];
      const menuContents = [...document.querySelectorAll('.menu-content')];

      function openSettingsTab(button) {
        menuButtons.forEach(item => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        menuContents.forEach(panel => {
          const active = panel.id === button.dataset.menu;
          panel.classList.toggle('hidden', !active);
          panel.hidden = !active;
        });
      }

      menuButtons.forEach((button, index) => {
        button.addEventListener('click', () => openSettingsTab(button));
        button.addEventListener('keydown', event => {
          if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(event.key)) return;
          event.preventDefault();
          const direction = ['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1;
          const next = menuButtons[(index + direction + menuButtons.length) % menuButtons.length];
          openSettingsTab(next);
          next.focus();
        });
      });

      function syncPreferenceControls(preferences = window.PeakPreferences?.get()) {
        if (!preferences) return;
        document.querySelectorAll('[data-preference]').forEach(control => {
          const value = preferences[control.dataset.preference];
          if (control.type === 'checkbox') control.checked = Boolean(value);
          if (control.type === 'radio') control.checked = String(value) === control.value;
        });
      }

      document.querySelectorAll('[data-preference]').forEach(control => {
        control.addEventListener('change', () => {
          let value = control.type === 'checkbox' ? control.checked : control.value;
          if (control.dataset.preference === 'defaultPeriod') value = Number(value);
          window.PeakPreferences?.set({ [control.dataset.preference]: value });
          showToast('Preferensi berhasil disimpan.', 'success', 2200);
        });
      });

      document.getElementById('resetPreferences').addEventListener('click', () => {
        const preferences = window.PeakPreferences?.reset();
        syncPreferenceControls(preferences);
        showToast('Semua preferensi dikembalikan ke pengaturan awal.', 'success', 3000);
      });

      window.addEventListener('peakpreferenceschange', event => syncPreferenceControls(event.detail));
      syncPreferenceControls();

      async function loadAccountForm() {
        try {
          const response = await fetch('/auth/profile');
          if (!response.ok) return;
          const data = await response.json();
          document.getElementById('firstName').value = data.user?.firstname || '';
          document.getElementById('lastName').value = data.user?.lastname || '';
        } catch (error) {
          console.error('Gagal memuat data akun:', error);
        }
      }

      async function changeName() {
        const firstName = document.getElementById('firstName').value.trim();
        const lastName = document.getElementById('lastName').value.trim();
        const saveButton = document.getElementById('saveNameButton');
        if (!firstName || !lastName) {
          showToast('Nama depan dan belakang wajib diisi.', 'error');
          return;
        }
        saveButton.disabled = true;
        try {
          const response = await fetch('/auth/profile', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ firstname: firstName, lastname: lastName })
          });
          if (!response.ok) throw new Error('Gagal memperbarui profil');
          showToast('Nama berhasil diperbarui.', 'success');
          window.fetchAndRenderProfile?.();
        } catch (error) {
          console.error('Error:', error);
          showToast('Nama gagal diperbarui. Silakan coba lagi.', 'error');
        } finally {
          saveButton.disabled = false;
        }
      }

      function showToast(message, type = 'success', duration = 5000) {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.innerHTML = `<span class="toast-icon"><i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-xmark'}"></i></span><div class="toast-copy"><strong>${type === 'success' ? 'Berhasil' : 'Gagal'}</strong><span></span></div><button class="toast-close" type="button" aria-label="Tutup notifikasi"><i class="fa-solid fa-xmark"></i></button><div class="toast-progress"></div>`;
        toast.querySelector('.toast-copy span').textContent = message;
        toast.querySelector('.toast-progress').style.animationDuration = `${duration}ms`;
        container.appendChild(toast);
        const timeout = setTimeout(remove, duration);
        toast.querySelector('.toast-close').addEventListener('click', remove);
        function remove() {
          clearTimeout(timeout);
          toast.style.animation = 'toastOut .3s ease forwards';
          setTimeout(() => toast.remove(), 300);
        }
      }

      loadAccountForm();
    </script>
  </body>
</html>
