<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pengaturan - PeakFinance</title>
    <link rel="stylesheet" href="<%= env.BASEURL_VITE %>/public/css/input.css">
    <script type="module" src="<%= env.BASEURL_VITE %>/@vite/client"></script>
    <link rel="stylesheet" href="/css/main.css" />
  </head>

  <body
    class="min-h-screen flex text-white bg-gradient-to-br from-[#020617] via-[#0f172a] to-[#020617]"
  >
    <!-- SIDEBAR -->
    <%- include('components/sidebar') %>

    <!-- MAIN -->
    <main class="main-content">
      <!-- HEADER -->
      <div class="page-header">
        <div>
          <h1 class="page-title">Pengaturan</h1>
          <p class="page-subtitle">Sesuaikan pengalaman dan kelola akunmu.</p>
        </div>
      </div>

      <!-- CONTENT -->
      <div class="settings-layout">
        <!-- MENU - horizontal tabs on mobile, vertical on desktop -->
        <div class="settings-tabs mobile-scroll-row" role="tablist" aria-label="Kategori pengaturan">
          <button
            class="menu-btn shrink-0 text-left px-4 py-2 bg-green-500/20 text-green-400 rounded-lg"
            data-menu="tampilan"
            role="tab"
            aria-selected="true"
          >
            Tampilan
          </button>

          <button
            class="menu-btn shrink-0 text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="aksesibilitas"
            role="tab"
            aria-selected="false"
          >
            Aksesibilitas
          </button>

          <button
            class="menu-btn shrink-0 text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="akun"
            role="tab"
            aria-selected="false"
          >
            Akun
          </button>

          <button
            class="menu-btn shrink-0 text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="bahasa"
            role="tab"
            aria-selected="false"
          >
            Bahasa
          </button>

          <button
            class="menu-btn shrink-0 text-left px-4 py-2 bg-[#020617] border border-gray-800 rounded-lg hover:bg-[#0b1220]"
            data-menu="personalisasi"
            role="tab"
            aria-selected="false"
          >
            Personalisasi
          </button>
        </div>

        <div
          class="settings-panel flex-1 p-4 sm:p-6 relative"
        >
          <!-- TAMPILAN PANEL -->
          <div id="tampilan" class="menu-content">
            <p class="text-gray-500 text-sm">
              Fitur tampilan akan dikembangkan
            </p>
          </div>

          <!-- AKSESIBILITAS PANEL -->
          <div id="aksesibilitas" class="menu-content hidden">
            <p class="text-gray-500 text-sm">
              Fitur aksesibilitas akan dikembangkan
            </p>
          </div>

          <!-- AKUN PANEL -->
          <div id="akun" class="menu-content hidden">
            <div class="space-y-6">
              <div>
                <h2 class="text-xl font-semibold mb-4">Akun</h2>
                <p class="text-gray-400 mb-6">Kelola pengaturan akun Anda</p>

                <div class="account-editor flex flex-col sm:flex-row sm:items-center gap-4">
                  <div
                    class="avatar w-16 h-16 sm:w-24 sm:h-24 flex items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-blue-500 text-black font-bold shrink-0"
                  >
                    <i class="text-xl sm:text-2xl fa-solid fa-user"></i>
                  </div>
                  <div class="flex-1 space-y-3">
                    <label for="firstName" class="sr-only">Nama depan</label>
                    <input
                      type="text"
                      id="firstName"
                      placeholder="First Name"
                      class="bg-[#020617] border border-gray-800 rounded-lg px-4 py-2 w-full text-gray-400"
                    />

                    <label for="lastName" class="sr-only">Nama belakang</label>
                    <input
                      type="text"
                      id="lastName"
                      placeholder="Last Name"
                      class="bg-[#020617] border border-gray-800 rounded-lg px-4 py-2 w-full text-gray-400"
                    />

                    <button type="button" onclick="changeName()" class="px-4 py-2 bg-blue-500/20 text-blue-400 rounded-lg border border-blue-500/30 hover:bg-blue-500/30 transition">
                      Simpan perubahan
                    </button>
                  </div>
                </div>
              </div>

              <div class="border-t border-gray-700 pt-6">
                <h3 class="text-sm font-semibold text-gray-300 mb-4">
                  Keamanan
                </h3>
                <form id="logoutForm" method="POST" action="/auth/logout">
                  <button
                    type="submit"
                    class="px-4 py-2 bg-red-500/20 text-red-400 rounded-lg border border-red-500/30 hover:bg-red-500/30 transition"
                  >
                    Keluar
                  </button>
                </form>
              </div>
            </div>
          </div>

          <!-- BAHASA PANEL -->
          <div id="bahasa" class="menu-content hidden">
            <p class="text-gray-500 text-sm">Fitur bahasa akan dikembangkan</p>
          </div>

          <!-- PERSONALISASI PANEL -->
          <div id="personalisasi" class="menu-content hidden">
            <p class="text-gray-500 text-sm">
              Fitur personalisasi akan dikembangkan
            </p>
          </div>

        </div>
      </div>
    </main>
    <div id="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>
    <script>
      // Menu handler
      const menuButtons = document.querySelectorAll(".menu-btn");
      const menuContents = document.querySelectorAll(".menu-content");

      menuButtons.forEach((button) => {
        button.addEventListener("click", function () {
          const menuId = this.getAttribute("data-menu");

          // Hide all contents
          menuContents.forEach((content) => {
            content.classList.add("hidden");
          });

          // Remove active state from all buttons
          menuButtons.forEach((btn) => {
            btn.setAttribute('aria-selected', 'false');
            btn.classList.remove("bg-green-500/20", "text-green-400");
            btn.classList.add(
              "bg-[#020617]",
              "border",
              "border-gray-800",
              "hover:bg-[#0b1220]",
            );
          });

          // Show selected content
          const selectedContent = document.getElementById(menuId);
          if (selectedContent) {
            selectedContent.classList.remove("hidden");
          }

          // Set button as active
          this.classList.remove(
            "bg-[#020617]",
            "border",
            "border-gray-800",
            "hover:bg-[#0b1220]",
          );
          this.classList.add("bg-green-500/20", "text-green-400");
          this.setAttribute('aria-selected', 'true');
        });
      });

      function changeName() {
        let firstName = document.getElementById("firstName").value;
        let lastName = document.getElementById("lastName").value;

        fetch("/auth/profile", {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ firstname: firstName, lastname: lastName }),
        }).then((response) => {
          if (response.ok) {
            showToast("Nama berhasil diperbarui.", "success");
          } else {
            showToast("Nama gagal diperbarui.", "error");
          }
        }).catch((error) => {
          console.error("Error:", error);
          showToast("Terjadi kesalahan. Silakan coba lagi.", "error");
        });
      }

      function showToast(message, type = "success", duration = 5000) {
        const container = document.getElementById("toast-container");

        const toast = document.createElement("div");
        toast.className = `toast toast-${type}`;

        toast.innerHTML = `
    <span style="font-size:20px">
      ${type === "success" ? "✅" : "❌"}
    </span>

    <div style="flex:1">
      <div style="font-weight:600; margin-bottom:2px">
        ${type === "success" ? "Berhasil" : "Gagal"}
      </div>
      <div style="font-size:13px; color:var(--app-muted)">
        ${message}
      </div>
    </div>

    <button class="toast-close">✖</button>

    <div class="toast-progress"></div>
  `;

        const progress = toast.querySelector(".toast-progress");
        progress.style.animationDuration = duration + "ms";

        const closeBtn = toast.querySelector(".toast-close");

        closeBtn.onclick = () => removeToast(toast);

        container.appendChild(toast);

        const timeout = setTimeout(() => {
          removeToast(toast);
        }, duration);

        function removeToast(el) {
          el.style.animation = "toastOut 0.3s ease forwards";
          clearTimeout(timeout);
          setTimeout(() => el.remove(), 300);
        }
      }

    </script>
  </body>
</html>
